rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner's progress lives in users/{uid}. Only that signed-in learner can read or change it.
    match /users/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['progress', 'updated']);
    }
  }
}
