- run([1, -2, 3, -4], 3)
- run([-3, -2, 7], 1)
- run([5, 4, -9, 6], 2)
- run([-1, -5], 4)
- run([0, 1, 2], 0)
- (lambda r: [len(r), r[:5], r[-5:], sum(r[::3])])(run([i * 7919 % 20001 - 10000 for i in range(15000)], 99999))
