def to_list(tail):
    items = []
    # your code here
    return items
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next

def build_circle(items):
    tail = None
    for x in items:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail

def to_list(tail):
    items = []
    if tail is None:
        return items
    node = tail.next
    while True:
        items.append(node.val)
        if node is tail:
            break
        node = node.next
    return items
```
tests:
