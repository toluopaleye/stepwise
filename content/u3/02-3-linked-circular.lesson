    # your code here
    return result


def run(nums, k):
    return rotate_elements(nums, k)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def rotate_elements(nums, k):
    kept = []
    for x in nums:
        if x >= 0:
            kept.append(x)
    if len(kept) == 0:
        return list(nums)
    tail = from_list(kept)
    for _ in range(k % len(kept)):
        tail = tail.next
    result = list(nums)
    node = tail.next
    for i in range(len(result)):
        if result[i] >= 0:
            result[i] = node.val
            node = node.next
    return result


def run(nums, k):
    return rotate_elements(nums, k)
```
