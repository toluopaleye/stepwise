def run(values):
    return to_list(thin(from_list(values)))
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def thin(tail):
    doomed = set()
    node = tail
    while True:
        if node.val < node.next.val:
            doomed.add(node)
        node = node.next
        if node is tail:
            break
    prev = tail
    node = tail.next
    while True:
        last = node is tail
        if node in doomed:
            prev.next = node.next
            if node is tail:
                tail = prev
        else:
            prev = node
        if last:
            return tail
        node = prev.next


def run(values):
    return to_list(thin(from_list(values)))
```
tests:
- run([3, 1, 4, 1, 5])
- run([1, 2, 3])
- run([7])
- run([3, 1, 2])
- run([5, 5, 4, 4])
- (lambda t: [len(t), t[:5], t[-5:], sum(t)])(run([i * 7919 % 10007 for i in range(8000)]))
fail[2]: 1 and 2 both go: compare 2 with the 3 after it in the original circle.
fail[3]: One node is its own next, and isn't smaller than itself.
fail[4]: 1 < 2, and the tail, 2, is smaller than the first node, 3: the tail goes, so the tail pointer moves back.
fail[5]: Only the tail, 4, is smaller than its next, the first 5.
fail[6]: 8000 nodes. Deleting each node by walking round to the node before it is O(n²).
edges:
- one node :: len(values) == 1 :: run([4])
- nothing deleted :: len(values) > 1 and all(values[i] >= values[(i + 1) % len(values)] for i in range(len(values))) :: run([2, 2])
- some nodes deleted :: any(values[i] < values[(i + 1) % len(values)] for i in range(len(values))) :: run([1, 2])
edge_count: 2
complexity: time=O(n) | space=O(n)
complexity_note: n is the number of nodes.
why_time: Two walks round the circle.
why_space: The set can hold all but one of the nodes.
hint: First walk: from `node = tail`, add node to doomed if `node.val < node.next.val`; step on until you're back at the tail.
hint: Second walk: `prev = tail` and `node = tail.next`. Set `last = node is tail`; if node is in doomed, `prev.next = node.next`, and if it's the tail, `tail = prev`; otherwise `prev = node`.
hint: Stop after the tail: if last, return tail; otherwise `node = prev.next`.
right: Making every choice first and deleting second keeps each comparison on the original circle, and prev makes each delete one link change.
wrong: Walk round once to collect the nodes smaller than their next, then walk round again with prev, linking out each collected node and moving the tail back if it goes.

=== task: code medium
title: Round Robin Scheduler
patterns: turns + delete
prompt: n programs share a processor, round robin. Program i needs `work[i]` units of time, and they take turns in order, 0, 1, 2 and round again. On its turn, a program runs for q units, or for less if it needs less, and a program that has done all its work leaves. Write `round_robin(tail, work, q)` that returns a Python list of the time each program finishes, starting from time 0.

The programs are a circle numbered 0 to n − 1, and `tail.next` is program 0. Take turns with `prev`, starting at the tail: each turn, `prev.next` runs for `min(q, left)`, where left is the work it has left. If it still has work, `prev` moves on to it. If it's done, write down its finish time and link it out, and `prev` stays. The last program to finish is alone in the circle: `node is prev`.

**Example 1:** `run([3, 1, 2], 2)` returns `[6, 3, 5]`: program 0 runs until time 2, program 1 finishes at 3, program 2 at 5, and program 0 at 6.

**Example 2:** `run([5], 3)` returns `[5]`.

**Constraints:** 1 ≤ n ≤ 2000, 1 ≤ work[i] ≤ 10⁵, 1 ≤ q ≤ 10⁴, and there are at most 10⁵ turns in all.
starter:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def round_robin(tail, work, q):
    left = list(work)
    finish = [0] * len(work)
    time = 0
    # your code here
    return finish


def run(work, q):
    tail = from_list(list(range(len(work))))
    return round_robin(tail, work, q)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def round_robin(tail, work, q):
    left = list(work)
    finish = [0] * len(work)
    time = 0
    prev = tail
    while True:
        node = prev.next
        slice_time = min(q, left[node.val])
        time += slice_time
        left[node.val] -= slice_time
        if left[node.val] > 0:
            prev = node
        else:
            finish[node.val] = time
            if node is prev:
                return finish
            prev.next = node.next


def run(work, q):
    tail = from_list(list(range(len(work))))
    return round_robin(tail, work, q)
```
tests:
- run([3, 1, 2], 2)
- run([5], 3)
- run([1, 1, 1], 1)
- run([4, 4], 2)
- run([2, 7, 1, 3], 3)
- (lambda r: [len(r), r[:5], r[-5:], sum(r)])(run([30000] + [1 + i % 3 for i in range(1999)], 1))
fail[2]: One program runs alone, for 3 units and then 2.
fail[3]: Each program needs one turn, so they finish in order.
fail[4]: Two programs take turns: 2 units each, twice.
fail[5]: Program 1 needs three turns; the others leave in their first or second.
fail[6]: 2000 programs, and program 0 needs 30,000 turns. Leaving finished programs in the circle and skipping them makes each of those turns walk past 1999 of them.
edges:
- one program :: len(work) == 1 :: run([2], 2)
- one turn each :: len(work) > 1 and max(work) <= q :: run([1, 2], 2)
- several turns :: len(work) > 1 and max(work) > q :: run([3, 1], 2)
edge_count: 2
complexity: time=O(n + t) | space=O(n)
complexity_options: O(n + t); O(n × t); O(t)
complexity_note: n is the number of programs and t is the number of turns.
why_time: Each turn is O(1): one slice of time and at most one link change.
why_space: The lists of work left and finish times.
hint: `prev = tail`. Loop forever: `node = prev.next`; it runs for `min(q, left[node.val])`, which you add to time and take from its work left.
hint: If it has work left, `prev = node`. Otherwise `finish[node.val] = time`; return finish if `node is prev`, and if not, `prev.next = node.next`.
right: A finished program is linked out at once, so every turn goes to a program that still has work, and the whole schedule takes one O(1) step per turn.
wrong: Walk round the circle with prev; each turn, prev.next runs for min(q, its work left); if it has work left, move prev on to it, and otherwise record its finish time and link it out, stopping when the last one finishes.

=== task: code medium
title: Pass the Parcel
patterns: count + delete
prompt: n players, numbered 1 to n, sit in a circle, and player 1 holds the parcel. Each round uses the next number s from `steps`: the parcel is passed s times round the circle, one player each pass, and whoever holds it then leaves the game, handing it to the next player on. After n − 1 rounds, one player is left: the winner. Write `pass_the_parcel(tail, steps)` that returns the players in the order they leave, and the winner.

Keep `prev` on the player right before the holder, starting at the tail, so the holder is always `prev.next`. Passing s times is s moves of `prev`, but going round the whole circle changes nothing, so `s % left` moves are enough, where `left` is the number of players still in. Then link the holder out, which leaves the next player holding the parcel.

**Example 1:** `run(5, [2, 0, 3, 1])` returns `[[3, 4, 5, 2], 1]`. Two passes take the parcel from 1 to 3, who leaves and hands it to 4; with no passes, 4 leaves; three passes go round 5, 1, 2 and back to 5, who leaves; one pass goes from 1 to 2, and player 1 wins.

**Example 2:** `run(1, [])` returns `[[], 1]`: one player wins at once.

**Constraints:** 1 ≤ n ≤ 1000, steps has n − 1 numbers, and 0 ≤ every step ≤ 10⁹.
starter:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def pass_the_parcel(tail, steps):
    order = []
    winner = tail.next.val
    # your code here
    return order, winner


def run(n, steps):
    tail = from_list(list(range(1, n + 1)))
    order, winner = pass_the_parcel(tail, steps)
    return [order, winner]
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def pass_the_parcel(tail, steps):
    left = 0
    node = tail.next
    while True:
        left += 1
        if node is tail:
            break
        node = node.next
    prev = tail
    order = []
    for s in steps:
        for _ in range(s % left):
            prev = prev.next
        leaving = prev.next
        prev.next = leaving.next
        order.append(leaving.val)
        left -= 1
    return order, prev.next.val


def run(n, steps):
    tail = from_list(list(range(1, n + 1)))
    order, winner = pass_the_parcel(tail, steps)
    return [order, winner]
```
tests:
- run(5, [2, 0, 3, 1])
- run(1, [])
- run(3, [7, 2])
- run(4, [1, 1, 1])
- run(6, [5, 4, 3, 2, 1])
- (lambda r: [len(r[0]), r[0][:5], r[0][-5:], sum(r[0][::7]), r[1]])(run(600, [10 ** 9 - i * 7919 for i in range(599)]))
fail[2]: One player and no rounds: player 1 wins.
fail[3]: 7 passes round 3 players is the same as 1 pass, so player 2 leaves first.
fail[4]: One pass each round: players 2, 4 and 3 leave.
fail[5]: Each round passes one fewer times than there are players, so the player right before the holder leaves each time.
fail[6]: 600 players and steps near 10⁹: passing one player at a time takes far too long; use `s % left`.
edges:
- one player :: n == 1 :: run(1, [])
- every count shorter than the circle :: n > 1 and all(steps[i] < n - i for i in range(n - 1)) :: run(2, [1])
- a count that goes round the circle :: any(steps[i] >= n - i for i in range(n - 1)) :: run(2, [5])
edge_count: 2
complexity: time=O(n²) | space=O(n)
complexity_note: n is the number of players.
why_time: Each of the n − 1 rounds moves fewer than `left` steps, and left is at most n.
why_space: The order of the n − 1 players who leave.
hint: Count the players with a walk round: that's left. Start `prev = tail`.
hint: For each s: move prev `s % left` times; `leaving = prev.next`; `prev.next = leaving.next`; append `leaving.val`; take 1 from left.
hint: After the last round, the winner is `prev.next.val`.
right: Passing the parcel `left` times brings it back to the same player, so s % left passes reach the right player, and linking them out hands the parcel on in O(1).
wrong: Keep prev right before the holder; each round, move prev s % left times, link out prev.next and record them, and take one from left; the winner is the last player left, prev.next.

=== task: code medium
title: Linked List Cycle II
leetcode: 142 | Linked List Cycle II | linked-list-cycle-ii
patterns: cycle
prompt: A singly linked list might loop. Write `detect_cycle(head)` that returns the node where the loop starts, the first node you reach twice walking from the head, or None if the list ends. Use O(1) extra space.

Use Floyd's algorithm to find where `slow` and `fast` meet. Then put one pointer back at the head, and move it and the meeting pointer one node at a time: they meet at the start of the loop.

The tests build the list with `build(values, pos)`: the nodes are linked in order, and if `pos` isn't −1, the last node links back to the node at index `pos`. `run` reports the index of the node you return, or −1 for None.

**Example 1:** `run([3, 2, 0, -4], 1)` returns 1: the loop starts at index 1.

**Example 2:** `run([1, 2], 0)` returns 0.

**Example 3:** `run([1], -1)` returns -1.

**Constraints:** the list has 0 to 10⁴ nodes, −10⁵ ≤ every value ≤ 10⁵, and `pos` is −1 or an index in the list.
starter:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def build(values, pos):
    nodes = [Node(x) for x in values]
    for i in range(len(nodes) - 1):
        nodes[i].next = nodes[i + 1]
    if pos >= 0:
        nodes[-1].next = nodes[pos]
    return nodes


def detect_cycle(head):
    # your code here
    return None


def run(values, pos):
    nodes = build(values, pos)
    head = None
    if len(nodes) > 0:
        head = nodes[0]
    start = detect_cycle(head)
    if start is None:
        return -1
    for i in range(len(nodes)):
        if nodes[i] is start:
            return i
    return "not a node of the list"
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def build(values, pos):
    nodes = [Node(x) for x in values]
    for i in range(len(nodes) - 1):
        nodes[i].next = nodes[i + 1]
    if pos >= 0:
        nodes[-1].next = nodes[pos]
    return nodes


def detect_cycle(head):
    slow = head
    fast = head
    meet = None
    while fast is not None and fast.next is not None:
        slow = slow.next
        fast = fast.next.next
        if slow is fast:
            meet = slow
            break
    if meet is None:
        return None
    node = head
    while node is not meet:
        node = node.next
        meet = meet.next
    return node


def run(values, pos):
    nodes = build(values, pos)
    head = None
    if len(nodes) > 0:
        head = nodes[0]
    start = detect_cycle(head)
    if start is None:
        return -1
    for i in range(len(nodes)):
        if nodes[i] is start:
            return i
    return "not a node of the list"
```
