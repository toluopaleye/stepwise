    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def min_swaps(tail):
    # your code here
    return 0


def run(nums):
    return min_swaps(from_list(nums))
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def min_swaps(tail):
    n = 0
    ones = 0
    node = tail.next
    while True:
        n += 1
        ones += node.val
        if node is tail:
            break
        node = node.next
    if ones == 0:
        return 0
    lag = tail.next
    lead = tail.next
    inside = 0
    for _ in range(ones):
        inside += lead.val
        lead = lead.next
    best = inside
    for _ in range(n):
        inside += lead.val - lag.val
        lead = lead.next
        lag = lag.next
        best = max(best, inside)
    return ones - best


def run(nums):
    return min_swaps(from_list(nums))
```
tests:
- run([0, 1, 0, 1, 1, 0, 0])
- run([0, 1, 1, 1, 0, 0, 1, 1, 0])
- run([1, 1, 0, 0, 1])
- run([0, 0])
- run([1, 0, 1, 0, 1, 0])
- run([1 if i * 7919 % 3 == 0 or i % 1000 < 400 else 0 for i in range(15000)])
fail[2]: The best window of five has two 0s in it.
fail[3]: The 1s are already together, across the join between the last node and the first.
fail[4]: No 1s at all, so there's nothing to group: 0 swaps.
fail[5]: Every window of three holds at most two 1s.
fail[6]: 15,000 nodes. Counting each window from scratch is O(n × ones); slide one window round with two pointers.
edges:
- no 1s :: 1 not in nums :: run([0, 0])
- only 1s :: 0 not in nums :: run([1, 1])
- a mix :: 0 in nums and 1 in nums :: run([1, 0])
edge_count: 2
complexity: time=O(n) | space=O(1)
complexity_note: n is the number of nodes.
why_time: One walk to count, `ones` steps to fill the first window, and n slides of one step each.
why_space: Two pointers and a few counts.
hint: Walk round once to count n and ones. If ones is 0, return 0.
hint: `lead` and `lag` start at `tail.next`. Move lead `ones` times, adding each value: inside is the number of 1s in the first window.
hint: n times: `inside += lead.val - lag.val`, move both on, and keep the largest inside as best. Return `ones - best`.
right: Every window of `ones` nodes round the circle is a place the 1s could end up, and each 0 inside it needs one swap, so the window with the most 1s needs the fewest swaps.
wrong: Count the 1s; slide a window of that many nodes all the way round the circle with two pointers, keeping the most 1s inside; the answer is the count minus that most.

