    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def time_to_buy(tail, tickets, k):
    need = list(tickets)
    time = 0
    # your code here
    return time


def run(tickets, k):
    tail = from_list(list(range(len(tickets))))
    return time_to_buy(tail, tickets, k)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def time_to_buy(tail, tickets, k):
    need = list(tickets)
    time = 0
    prev = tail
    while True:
        node = prev.next
        need[node.val] -= 1
        time += 1
        if need[node.val] > 0:
            prev = node
        elif node.val == k:
            return time
        else:
            prev.next = node.next


def run(tickets, k):
    tail = from_list(list(range(len(tickets))))
    return time_to_buy(tail, tickets, k)
```
tests:
- run([2, 3, 2], 2)
- run([5, 1, 1, 1], 0)
- run([1], 0)
- run([3, 1, 2], 0)
- run([1, 1, 5, 1], 3)
- [run([i * 37 % 100 + 1 for i in range(100)], 50), run([100] * 100, 99), run([100] * 100, 0)]
fail[2]: Person 0 needs 5 tickets; the others leave after their first, and person 0 buys the rest alone.
fail[3]: One person, one ticket: 1 second.
fail[4]: Person 1 leaves after second 2 and person 2 after second 5, and person 0 finishes at second 6.
fail[5]: Person 3 finishes in the first round, at second 4, while person 2 still has tickets to buy.
fail[6]: 100 people buying up to 100 tickets each: up to 10,000 seconds.
edges:
- one person :: len(tickets) == 1 :: run([3], 0)
- k at the front :: len(tickets) > 1 and k == 0 :: run([1, 2], 0)
- k further back :: k > 0 :: run([2, 1], 1)
edge_count: 2
complexity: time=O(n × m) | space=O(n)
complexity_options: O(n × m); O(n + m); O(m)
complexity_note: n is the number of people and m is tickets[k], the number person k wants.
why_time: Each second is O(1), and person k is done after at most m rounds of at most n people.
why_space: `need` copies the n ticket counts.
hint: Start with `prev = tail`, then loop forever: `node = prev.next`; take 1 from `need[node.val]` and add 1 to time.
hint: If `need[node.val] > 0`, they stay: `prev = node`.
hint: Otherwise, if `node.val == k`, return time; if not, they leave: `prev.next = node.next`, and prev stays where it is.
right: Each second is one turn round the circle, and people who are done are linked out, so the turns only ever go to people still in the line.
wrong: Walk round the circle with prev: each second, prev.next buys one ticket; if they need more, move prev on to them; if they're done, return the time if it's person k, and otherwise link them out of the circle.

=== task: code easy
title: Find the Losers of the Circular Game
leetcode: 2682 | Find the Losers of the Circular Game | find-the-losers-of-the-circular-game
patterns: count
prompt: n friends, numbered 1 to n, sit in a circle, and friend 1 has the ball. On turn i, whoever has the ball passes it i × k friends on, round the circle: k on the first turn, then 2 × k, then 3 × k. The game ends when a friend gets the ball for the second time. Write `circular_game_losers(tail, n, k)` that returns the friends who never had the ball, in increasing order.

The friends are a circle, and `tail.next` is friend 1. Passing the ball i × k friends on is i × k steps along `next`, but n steps go round the circle back to the same friend, so `(i * k) % n` steps are enough. Keep a set of the friends who have had the ball.

**Example 1:** `run(5, 2)` returns `[4, 5]`: the ball goes from 1 to 3 (2 on), then to 2 (4 on), then to 3 (6 on), and friend 3 has had it before.

**Example 2:** `run(4, 4)` returns `[2, 3, 4]`: 4 steps go all the way round, so the ball comes straight back to friend 1.

**Constraints:** 1 ≤ k ≤ n ≤ 50.
starter:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def circular_game_losers(tail, n, k):
    node = tail.next
    got = {node.val}
    # your code here
    losers = []
    return losers


def run(n, k):
    tail = from_list(list(range(1, n + 1)))
    return circular_game_losers(tail, n, k)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    tail = None
    for x in values:
        node = Node(x)
        if tail is None:
            node.next = node
        else:
            node.next = tail.next
            tail.next = node
        tail = node
    return tail


def to_list(tail):
    values = []
    if tail is None:
        return values
    node = tail.next
    while True:
        if node is None:
            return "the circle is broken: a next link is None"
        values.append(node.val)
        if node is tail:
            return values
        if len(values) > 100000:
            return "the walk never came back to the tail"
        node = node.next


def circular_game_losers(tail, n, k):
    node = tail.next
    got = {node.val}
    turn = 1
    while True:
        for _ in range(turn * k % n):
            node = node.next
        if node.val in got:
            break
        got.add(node.val)
        turn += 1
    losers = []
    for friend in range(1, n + 1):
        if friend not in got:
            losers.append(friend)
    return losers


def run(n, k):
    tail = from_list(list(range(1, n + 1)))
    return circular_game_losers(tail, n, k)
```
tests:
- run(5, 2)
- run(4, 4)
- run(1, 1)
- run(2, 1)
- run(6, 3)
- [run(50, 7), run(47, 46), run(50, 50), run(49, 1)]
fail[2]: 4 steps round a circle of 4 is a full turn: the ball goes straight back to friend 1.
fail[3]: One friend, who has the ball: nobody loses.
fail[4]: Friend 1 passes to friend 2, who passes it 2 on, round to friend 2 again.
fail[5]: 3 steps reach friend 4, then 6 steps go all the way round to friend 4.
fail[6]: Four games with up to 50 friends.
edges:
- one friend :: n == 1 :: run(1, 1)
- k equals n :: n > 1 and k == n :: run(3, 3)
- k smaller than n :: k < n :: run(3, 1)
edge_count: 2
complexity: time=O(n²) | space=O(n)
complexity_note: n is the number of friends.
why_time: Someone gets the ball twice within n + 1 turns, and each turn moves fewer than n steps.
why_space: The set of friends who've had the ball, and the list of losers.
hint: Keep `turn = 1`. Loop: move `node` along next `turn * k % n` times.
hint: If `node.val` is in got, stop; otherwise add it to got and add 1 to turn.
hint: Then, for each friend from 1 to n, add them to losers if they aren't in got.
right: A number of steps that's a multiple of n goes round the circle to where it started, so each turn needs only (i × k) % n steps, fewer than n.
wrong: Move the ball (turn × k) % n steps round the circle each turn, stopping at the first friend who has had it already; the losers are the friends never reached, in order.

=== task: code easy
title: Linked List Cycle
leetcode: 141 | Linked List Cycle | linked-list-cycle
patterns: cycle
prompt: A singly linked list might loop: its last node might link back to an earlier node instead of to None. Write `has_cycle(head)` that returns True if the list has a cycle, and False if it ends.

Use Floyd's algorithm: `slow` and `fast` both start at the head, and each step `slow` moves one node and `fast` moves two. If `fast` reaches the end, there's no cycle. If the two pointers ever land on the same node, there is one.

The tests build the list with `build(values, pos)`: the nodes are linked in order, and if `pos` isn't −1, the last node links back to the node at index `pos`.

**Example 1:** `run([3, 2, 0, -4], 1)` returns True: the last node links back to the node at index 1.

**Example 2:** `run([1, 2], 0)` returns True.

**Example 3:** `run([1], -1)` returns False: one node, linking to None.

**Constraints:** the list has 0 to 10⁴ nodes, −10⁵ ≤ every value ≤ 10⁵, and `pos` is −1 or an index in the list.
starter:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def build(values, pos):
    nodes = [Node(x) for x in values]
    for i in range(len(nodes) - 1):
        nodes[i].next = nodes[i + 1]
    if pos >= 0:
        nodes[-1].next = nodes[pos]
    return nodes


def has_cycle(head):
    # your code here
    return False


def run(values, pos):
    nodes = build(values, pos)
    head = None
    if len(nodes) > 0:
        head = nodes[0]
    return has_cycle(head)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def build(values, pos):
    nodes = [Node(x) for x in values]
    for i in range(len(nodes) - 1):
        nodes[i].next = nodes[i + 1]
    if pos >= 0:
        nodes[-1].next = nodes[pos]
    return nodes


def has_cycle(head):
    slow = head
    fast = head
    while fast is not None and fast.next is not None:
        slow = slow.next
        fast = fast.next.next
        if slow is fast:
            return True
    return False


def run(values, pos):
    nodes = build(values, pos)
    head = None
    if len(nodes) > 0:
        head = nodes[0]
    return has_cycle(head)
```
