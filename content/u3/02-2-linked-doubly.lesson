    for command, args in zip(commands, inputs):
        if command == "OrderedMap":
            m = OrderedMap()
            results.append(None)
        elif command == "set":
            results.append(m.set(args[0], args[1]))
        elif command == "get":
            results.append(m.get(args[0]))
        elif command == "delete":
            results.append(m.delete(args[0]))
        elif command == "move_to_end":
            results.append(m.move_to_end(args[0], args[1]))
        elif command == "pop_item":
            results.append(m.pop_item(args[0]))
        elif command == "keys":
            results.append(m.keys())
    return results
```
solution:
```python
class Entry:
    def __init__(self, key, value):
        self.key = key
        self.value = value
        self.prev = None
        self.next = None


class OrderedMap:
    def __init__(self):
        self.front = Entry(None, None)
        self.back = Entry(None, None)
        self.front.next = self.back
        self.back.prev = self.front
        self.where = {}

    def unlink(self, e):
        e.prev.next = e.next
        e.next.prev = e.prev

    def insert_after(self, left, e):
        e.prev = left
        e.next = left.next
        left.next.prev = e
        left.next = e

    def set(self, key, value):
        if key in self.where:
            self.where[key].value = value
        else:
            e = Entry(key, value)
            self.where[key] = e
            self.insert_after(self.back.prev, e)

    def get(self, key):
        if key not in self.where:
            return -1
        return self.where[key].value

    def delete(self, key):
        if key not in self.where:
            return False
        self.unlink(self.where.pop(key))
        return True

    def move_to_end(self, key, last):
        e = self.where[key]
        self.unlink(e)
        if last:
            self.insert_after(self.back.prev, e)
        else:
            self.insert_after(self.front, e)

    def pop_item(self, last):
        if len(self.where) == 0:
            return []
        if last:
            e = self.back.prev
        else:
            e = self.front.next
        self.unlink(e)
        del self.where[e.key]
        return [e.key, e.value]

    def keys(self):
        out = []
        e = self.front.next
        while e is not self.back:
            out.append(e.key)
            e = e.next
        return out


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "OrderedMap":
            m = OrderedMap()
            results.append(None)
        elif command == "set":
            results.append(m.set(args[0], args[1]))
        elif command == "get":
            results.append(m.get(args[0]))
        elif command == "delete":
            results.append(m.delete(args[0]))
        elif command == "move_to_end":
            results.append(m.move_to_end(args[0], args[1]))
        elif command == "pop_item":
            results.append(m.pop_item(args[0]))
        elif command == "keys":
            results.append(m.keys())
    return results
```
tests:
- run(["OrderedMap", "set", "set", "set", "keys", "set", "get", "move_to_end", "keys", "pop_item", "keys"], [[], ["a", 1], ["b", 2], ["c", 3], [], ["a", 9], ["a"], ["a", True], [], [False], []])
- run(["OrderedMap", "get", "delete", "pop_item", "keys"], [[], ["x"], ["x"], [True], []])
- run(["OrderedMap", "set", "set", "move_to_end", "pop_item", "pop_item", "pop_item"], [[], ["a", 1], ["b", 2], ["b", False], [True], [True], [True]])
- run(["OrderedMap", "set", "delete", "set", "keys", "get"], [[], ["k", 1], ["k"], ["k", 2], [], ["k"]])
- run(["OrderedMap", "set", "set", "set", "delete", "move_to_end", "keys"], [[], ["a", 1], ["b", 2], ["c", 3], ["b"], ["c", False], []])
- (lambda r: [len(r[-1]), r[-1][:4], r[-1][-4:], sum(x for x in r if isinstance(x, int)), [x for x in r if isinstance(x, list) and len(x) == 2][-2:]])(run(["OrderedMap"] + ["set"] * 3000 + ["move_to_end", "get"] * 2000 + ["delete", "pop_item"] * 500 + ["keys"], [[]] + [["k" + str(i), i] for i in range(3000)] + [a for i in range(2000) for a in (["k" + str(i * 7 % 3000), i % 2 == 0], ["k" + str(i * 13 % 3000)])] + [a for i in range(500) for a in (["k" + str(i * 3)], [i % 2 == 0])] + [[]]))
fail[2]: An empty map: get returns −1, delete returns False, and pop_item returns [].
fail[3]: b moves to the front, then three pops from the end take a, then b, then find nothing.
fail[4]: A key that's deleted and set again goes at the end, with its new value.
fail[5]: After b is deleted, c moves to the front, in front of a.
fail[6]: 3,000 keys, then 5,000 more calls. Moving keys in a Python list is O(n) each time; relink entries.
edges:
- nothing set :: "set" not in commands :: run(["OrderedMap", "keys"], [[], []])
- a key set twice :: len([a[0] for c, a in zip(commands, inputs) if c == "set"]) > len(set(a[0] for c, a in zip(commands, inputs) if c == "set")) :: run(["OrderedMap", "set", "set"], [[], ["a", 1], ["a", 2]])
- every key set once :: "set" in commands and len([a[0] for c, a in zip(commands, inputs) if c == "set"]) == len(set(a[0] for c, a in zip(commands, inputs) if c == "set")) :: run(["OrderedMap", "set", "set"], [[], ["a", 1], ["b", 2]])
edge_count: 2
complexity: time=O(1) | space=O(n)
complexity_note: Give the time of one call other than keys; n is the number of keys.
why_time: The dictionary finds an entry in O(1), and every change is an unlink, an insert after a node, or both.
why_space: One entry and one dictionary item per key.
hint: unlink(e): `e.prev.next = e.next` and `e.next.prev = e.prev`. insert_after(left, e): `e.prev = left`, `e.next = left.next`, `left.next.prev = e`, `left.next = e`.
hint: set: if the key is in self.where, change its entry's value; otherwise make an Entry, store it in self.where, and insert it after self.back.prev.
hint: move_to_end: unlink the entry, then insert it after self.back.prev if last is True, or after self.front if not. pop_item: [] if self.where is empty; otherwise take self.back.prev or self.front.next, unlink it, delete its key from self.where, and return [e.key, e.value].
right: The dictionary finds any key's entry in O(1), and the sentinels give every entry neighbours on both sides, so moving or removing an entry is the same couple of link changes wherever it is.
wrong: Keep each key's entry in a linked list between sentinels and in a dictionary; set appends new entries before the back sentinel, move_to_end unlinks an entry and links it in at either end, and pop_item unlinks an end entry.

=== task: code hard
title: Cut and Paste
patterns: unlink + insert
prompt: Write a class `Clipboard` for a doubly linked list built from values, whose nodes are numbered by their index in values:

- `Clipboard(values)` builds the list.
- `cut(a, b)` takes the nodes from node a to node b out of the list and keeps them, in order, on the clipboard. Node a comes before node b in the list, or is node b. Whatever was on the clipboard before is thrown away.
- `paste(c)` puts the clipboard's nodes back into the list right after node c, in order, and empties the clipboard; c = −1 means at the front. The clipboard isn't empty, and node c is in the list.
- `values()` returns the values in the list, in order.

cut and paste must be O(1), however many nodes move. A stretch of nodes keeps its own links, so only the links at its two ends change. The starter keeps the nodes in a Python list by number, between two sentinels, and remembers the clipboard's first and last nodes.

**Example:** `run(["Clipboard", "cut", "values", "paste", "values"], [[[1, 2, 3, 4, 5]], [1, 2], [], [4], []])` returns `[None, None, [1, 4, 5], None, [1, 4, 5, 2, 3]]`: nodes 1 and 2, which hold 2 and 3, move to after node 4.

**Constraints:** there are 1 to 10⁴ values, −10⁹ ≤ every value ≤ 10⁹, and at most 10⁴ calls.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Clipboard:
    def __init__(self, values):
        self.front = DNode(None)
        self.back = DNode(None)
        self.nodes = []
        last = self.front
        for x in values:
            node = DNode(x, last)
            last.next = node
            self.nodes.append(node)
            last = node
        last.next = self.back
        self.back.prev = last
        self.first = None
        self.last = None

    def cut(self, a, b):
        pass

    def paste(self, c):
        pass

    def values(self):
        out = []
        node = self.front.next
        while node is not self.back:
            out.append(node.val)
            node = node.next
        return out


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Clipboard":
            board = Clipboard(args[0])
            results.append(None)
        elif command == "cut":
            results.append(board.cut(args[0], args[1]))
        elif command == "paste":
            results.append(board.paste(args[0]))
        elif command == "values":
            results.append(board.values())
    return results
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Clipboard:
    def __init__(self, values):
        self.front = DNode(None)
        self.back = DNode(None)
        self.nodes = []
        last = self.front
        for x in values:
            node = DNode(x, last)
            last.next = node
            self.nodes.append(node)
            last = node
        last.next = self.back
        self.back.prev = last
        self.first = None
        self.last = None

    def cut(self, a, b):
        first = self.nodes[a]
        last = self.nodes[b]
        first.prev.next = last.next
        last.next.prev = first.prev
        self.first = first
        self.last = last

    def paste(self, c):
        if c == -1:
            left = self.front
        else:
            left = self.nodes[c]
        right = left.next
        left.next = self.first
        self.first.prev = left
        self.last.next = right
        right.prev = self.last
        self.first = None
        self.last = None

    def values(self):
        out = []
        node = self.front.next
        while node is not self.back:
            out.append(node.val)
            node = node.next
        return out


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Clipboard":
            board = Clipboard(args[0])
            results.append(None)
        elif command == "cut":
            results.append(board.cut(args[0], args[1]))
        elif command == "paste":
            results.append(board.paste(args[0]))
        elif command == "values":
            results.append(board.values())
    return results
```
