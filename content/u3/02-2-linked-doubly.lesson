    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def run_tape(program):
    cursor = DNode(0)
    leftmost = cursor
    for command in program:
        # your code here
        pass
    return leftmost


def run(program):
    return to_list(run_tape(program))
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def run_tape(program):
    cursor = DNode(0)
    leftmost = cursor
    for command in program:
        if command == "L":
            if cursor.prev is None:
                cell = DNode(0, None, cursor)
                cursor.prev = cell
                leftmost = cell
            cursor = cursor.prev
        elif command == "R":
            if cursor.next is None:
                cursor.next = DNode(0, cursor)
            cursor = cursor.next
        elif command == "I":
            cell = DNode(0, cursor, cursor.next)
            if cursor.next is not None:
                cursor.next.prev = cell
            cursor.next = cell
            cursor = cell
        elif command == "+":
            cursor.val += 1
        elif command == "-":
            cursor.val -= 1
    return leftmost


def run(program):
    return to_list(run_tape(program))
```
tests:
- run("+R++L-")
- run("")
- run("L")
- run("+I+I+")
- run("+++L+I-R")
- (lambda t: [len(t), t[:5], t[-5:], sum(t)])(run("L+" * 2500 + "R" * 2500 + "I-" * 1000 + "R+" * 1500))
fail[2]: An empty program: the tape is one cell holding 0.
fail[3]: Moving left from the only cell adds a new leftmost cell.
fail[4]: Each I adds a cell after the cursor and moves onto it.
fail[5]: An I in the middle of the tape: the new cell's neighbours must link to it in both directions.
fail[6]: 12,500 commands that grow the tape to 5,001 cells, 2,500 of them at the left end. Inserting at the front of a Python list is O(n) each time; grow the linked list at its end instead.
edges:
- no moves :: "L" not in program and "R" not in program :: run("+")
- moves left :: "L" in program :: run("L")
- moves right only :: "R" in program and "L" not in program :: run("R")
edge_count: 2
complexity: time=O(p) | space=O(p)
complexity_options: O(p); O(p²); O(n)
complexity_note: p is the number of commands.
why_time: Every command is O(1): a step, a new cell at the cursor or at an end, or a change to one cell.
why_space: Each command adds at most one cell.
hint: L: if cursor.prev is None, make `cell = DNode(0, None, cursor)`, link `cursor.prev = cell` and set leftmost = cell. Then `cursor = cursor.prev`.
hint: R: if cursor.next is None, `cursor.next = DNode(0, cursor)`. Then `cursor = cursor.next`.
hint: I: `cell = DNode(0, cursor, cursor.next)`; if cursor.next isn't None, `cursor.next.prev = cell`; then `cursor.next = cell` and `cursor = cell`. + and - change cursor.val.
right: Growing the tape means inserting next to the cursor, which is O(1) whether the cursor is at an end or in the middle, so the program runs in one pass, however far the cursor goes.
wrong: Keep the cursor on a cell and a pointer to the leftmost cell; moving past an end first adds a cell there, I inserts a cell after the cursor and moves onto it, and + and - change the cursor's cell.

=== task: code medium
title: Leaving the Line
patterns: map + unlink
prompt: Write a class `Line` for people waiting in a queue:

- `Line()` starts empty.
- `join(name)` adds name at the back. The names in the line are all different.
- `leave(name)` takes name out of the line, wherever they are, and returns True; it returns False if name isn't in the line.
- `serve()` takes the person at the front out of the line and returns their name, or returns "" if the line is empty.
- `size()` returns how many people are in the line.

Every method must be O(1). The starter keeps the line between two sentinels, front first, and a dictionary `where` from each name to its node: join links a node in before the back sentinel and records it, and leave finds the node in the dictionary and unlinks it.

**Example:** `run(["Line", "join", "join", "join", "leave", "serve", "size", "serve", "serve"], [[], ["ann"], ["bob"], ["cy"], ["bob"], [], [], [], []])` returns `[None, None, None, None, True, "ann", 1, "cy", ""]`.

**Constraints:** at most 10⁴ calls, and names are non-empty strings.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Line:
    def __init__(self):
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.where = {}

    def join(self, name):
        pass

    def leave(self, name):
        return False

    def serve(self):
        return ""

    def size(self):
        return 0


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Line":
            line = Line()
            results.append(None)
        elif command == "join":
            results.append(line.join(args[0]))
        elif command == "leave":
            results.append(line.leave(args[0]))
        elif command == "serve":
            results.append(line.serve())
        elif command == "size":
            results.append(line.size())
    return results
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Line:
    def __init__(self):
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.where = {}

    def join(self, name):
        last = self.back.prev
        node = DNode(name, last, self.back)
        last.next = node
        self.back.prev = node
        self.where[name] = node

    def unlink(self, node):
        node.prev.next = node.next
        node.next.prev = node.prev
        del self.where[node.val]

    def leave(self, name):
        if name not in self.where:
            return False
        self.unlink(self.where[name])
        return True

    def serve(self):
        if self.front.next is self.back:
            return ""
        node = self.front.next
        self.unlink(node)
        return node.val

    def size(self):
        return len(self.where)


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Line":
            line = Line()
            results.append(None)
        elif command == "join":
            results.append(line.join(args[0]))
        elif command == "leave":
            results.append(line.leave(args[0]))
        elif command == "serve":
            results.append(line.serve())
        elif command == "size":
            results.append(line.size())
    return results
```
tests:
- run(["Line", "join", "join", "join", "leave", "serve", "size", "serve", "serve"], [[], ["ann"], ["bob"], ["cy"], ["bob"], [], [], [], []])
- run(["Line", "serve", "leave", "size"], [[], [], ["x"], []])
- run(["Line", "join", "leave", "join", "serve"], [[], ["a"], ["a"], ["a"], []])
- run(["Line", "join", "join", "leave", "leave", "size"], [[], ["a"], ["b"], ["b"], ["b"], []])
- run(["Line", "join", "join", "join", "leave", "leave", "serve"], [[], ["a"], ["b"], ["c"], ["a"], ["c"], []])
- (lambda r: [r.count(True), r.count(False), [x for x in r if isinstance(x, str)][-3:], r[-1]])(run(["Line"] + [("join", "join", "join", "leave", "serve")[i % 5] for i in range(6000)] + ["size"], [[]] + [["p" + str(i)] if i % 5 < 3 else ["q" + str(i)] if i % 10 == 3 else ["p" + str(i * 7 % (i + 1))] if i % 5 == 3 else [] for i in range(6000)] + [[]]))
fail[2]: An empty line: serve returns "", leave returns False, and size is 0.
fail[3]: Someone who left can join again, at the back.
fail[4]: Leaving twice: the second time, the name isn't in the line.
fail[5]: The front and the back both leave, so b is served.
fail[6]: 6,000 calls on a line of up to 1,800 people. Removing from a Python list is O(n) each time; unlink nodes.
edges:
- nobody joins :: "join" not in commands :: run(["Line", "serve"], [[], []])
- someone leaves :: "join" in commands and "leave" in commands :: run(["Line", "join", "leave"], [[], ["a"], ["a"]])
- nobody leaves :: "join" in commands and "leave" not in commands :: run(["Line", "join", "serve"], [[], ["a"], []])
edge_count: 2
complexity: time=O(1) | space=O(n)
complexity_note: Give the time of one call; n is the number of people in the line.
why_time: The dictionary finds a person's node in O(1), and joining, leaving and serving are each a few link changes.
why_space: One node and one dictionary entry for each person in the line.
hint: join: last = self.back.prev; `node = DNode(name, last, self.back)`; `last.next = node`; `self.back.prev = node`; `self.where[name] = node`.
hint: Write unlink(node): `node.prev.next = node.next`, `node.next.prev = node.prev`, and `del self.where[node.val]`.
hint: leave: return False if name isn't in self.where; otherwise unlink its node and return True. serve: return "" if `self.front.next is self.back`; otherwise unlink self.front.next and return its name. size: `len(self.where)`.
right: The dictionary turns "find this person" into O(1), and because a doubly linked node knows both its neighbours, unlinking it from the middle of the line is O(1) too.
wrong: Keep the line between sentinels with a dictionary from name to node; join links a node in at the back, leave looks the node up and unlinks it, and serve unlinks the first node.

=== task: code medium
title: Recently Used List
patterns: sentinel + map
prompt: Write a class `RecentlyUsed` that keeps items in order of their last use, most recent first:

- `RecentlyUsed()` starts empty.
- `use(x)` records a use of x: x moves to the front, or is added at the front if it's new.
- `forget(x)` removes x and returns True, or returns False if x isn't there.
- `recent(k)` returns the k most recently used items, most recent first, or all of them if there are fewer than k.

use and forget must be O(1), and recent O(k). Keep the items between two sentinels, most recent first, with a dictionary from each item to its node: use either takes the item's node out or makes a new one, then links it in right after the front sentinel.

**Example:** `run(["RecentlyUsed", "use", "use", "use", "use", "recent", "forget", "recent"], [[], [1], [2], [3], [1], [5], [2], [2]])` returns `[None, None, None, None, None, [1, 3, 2], True, [1, 3]]`: using 1 again moves it in front of 3 and 2.

**Constraints:** at most 10⁴ calls, 0 ≤ x ≤ 10⁹, and 0 ≤ k ≤ 10⁴.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class RecentlyUsed:
    def __init__(self):
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.where = {}

    def use(self, x):
        pass

    def forget(self, x):
        return False

    def recent(self, k):
        return []


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RecentlyUsed":
            items = RecentlyUsed()
            results.append(None)
        elif command == "use":
            results.append(items.use(args[0]))
        elif command == "forget":
