    return values


def last_node(head):
    node = head
    while node is not None and node.next is not None:
        node = node.next
    return node


def minimum_refill(head, tail, capacity_a, capacity_b):
    a = capacity_a
    b = capacity_b
    left = head
    right = tail
    refills = 0
    # your code here
    return refills


def run(plants, capacity_a, capacity_b):
    head = from_list(plants)
    return minimum_refill(head, last_node(head), capacity_a, capacity_b)
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def last_node(head):
    node = head
    while node is not None and node.next is not None:
        node = node.next
    return node


def minimum_refill(head, tail, capacity_a, capacity_b):
    a = capacity_a
    b = capacity_b
    left = head
    right = tail
    refills = 0
    while left is not right and left.prev is not right:
        if a < left.val:
            a = capacity_a
            refills += 1
        a -= left.val
        if b < right.val:
            b = capacity_b
            refills += 1
        b -= right.val
        left = left.next
        right = right.prev
    if left is right and max(a, b) < left.val:
        refills += 1
    return refills


def run(plants, capacity_a, capacity_b):
    head = from_list(plants)
    return minimum_refill(head, last_node(head), capacity_a, capacity_b)
```
tests:
- run([2, 2, 3, 3], 5, 5)
- run([2, 2, 3, 3], 3, 4)
- run([5], 10, 8)
- run([1, 4, 1], 4, 4)
- run([3, 3], 3, 3)
- run([i * 7919 % 1000 + 1 for i in range(20001)], 2500, 1900)
fail[2]: Both run short on their second plant, so each refills once.
fail[3]: One plant is the middle plant: the one with more water waters it.
fail[4]: Both have 3 left at the middle plant, which needs 4, so one refill.
fail[5]: Two plants: one each, and no middle plant.
fail[6]: 20,001 plants, with a middle plant at the end of the walk.
edges:
- one plant :: len(plants) == 1 :: run([3], 3, 3)
- an even number of plants :: len(plants) % 2 == 0 :: run([1, 2], 2, 2)
- an odd number, more than one :: len(plants) % 2 == 1 and len(plants) > 1 :: run([1, 2, 1], 2, 2)
edge_count: 2
complexity: time=O(n) | space=O(1)
complexity_note: n is the number of plants.
why_time: The two pointers meet in the middle after about n / 2 steps each.
why_space: Two pointers, two amounts of water and a count.
hint: While `left is not right` and `left.prev is not right`: if a < left.val, refill a to capacity_a and add 1 to refills; then `a -= left.val`. Do the same for Bob with right and b.
hint: Then move left to left.next and right to right.prev.
hint: After the loop, if `left is right` and max(a, b) < left.val, add one more refill.
right: Alice's pointer walks along next and Bob's along prev, so the two ends are handled together in one pass, and the stopping rule tells whether a middle plant is left for whoever has more water.
wrong: Move one pointer from each end towards the middle, refilling each can when it can't water its plant; when they land on the same plant, refill only if neither has enough.

=== task: code medium
title: Merge Adjacent Equal Elements
