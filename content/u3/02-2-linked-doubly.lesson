    return values


def closest_earlier(values):
    n = len(values)
    order = sorted(range(n), key=lambda i: values[i])
    nodes = [None] * n
    # your code here
    answer = [-1] * n
    return answer


def run(values):
    return closest_earlier(values)
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def closest_earlier(values):
    n = len(values)
    order = sorted(range(n), key=lambda i: values[i])
    nodes = [None] * n
    prev = None
    for i in order:
        node = DNode(i, prev)
        if prev is not None:
            prev.next = node
        nodes[i] = node
        prev = node
    answer = [-1] * n
    for i in range(n - 1, 0, -1):
        node = nodes[i]
        best = None
        if node.prev is not None:
            best = values[i] - values[node.prev.val]
        if node.next is not None:
            gap = values[node.next.val] - values[i]
            if best is None or gap < best:
                best = gap
        answer[i] = best
        if node.prev is not None:
            node.prev.next = node.next
        if node.next is not None:
            node.next.prev = node.prev
    return answer


def run(values):
    return closest_earlier(values)
```
