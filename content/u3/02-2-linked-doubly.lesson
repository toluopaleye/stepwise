```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class RecentlyUsed:
    def __init__(self):
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.where = {}

    def unlink(self, node):
        node.prev.next = node.next
        node.next.prev = node.prev

    def push_front(self, node):
        node.prev = self.front
        node.next = self.front.next
        self.front.next.prev = node
        self.front.next = node

    def use(self, x):
        if x in self.where:
            node = self.where[x]
            self.unlink(node)
        else:
            node = DNode(x)
            self.where[x] = node
        self.push_front(node)

    def forget(self, x):
        if x not in self.where:
            return False
        self.unlink(self.where.pop(x))
        return True

    def recent(self, k):
        out = []
        node = self.front.next
        while node is not self.back and len(out) < k:
            out.append(node.val)
            node = node.next
        return out


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RecentlyUsed":
            items = RecentlyUsed()
            results.append(None)
        elif command == "use":
            results.append(items.use(args[0]))
        elif command == "forget":
            results.append(items.forget(args[0]))
        elif command == "recent":
            results.append(items.recent(args[0]))
    return results
```
tests:
- run(["RecentlyUsed", "use", "use", "use", "use", "recent", "forget", "recent"], [[], [1], [2], [3], [1], [5], [2], [2]])
- run(["RecentlyUsed", "recent", "forget"], [[], [3], [1]])
- run(["RecentlyUsed", "use", "use", "use", "recent"], [[], [7], [7], [7], [2]])
- run(["RecentlyUsed", "use", "use", "forget", "use", "recent"], [[], [1], [2], [1], [1], [5]])
- run(["RecentlyUsed", "use", "use", "use", "use", "recent"], [[], [1], [2], [3], [2], [1]])
- (lambda r: [r.count(True), r.count(False), r[-1]])(run(["RecentlyUsed"] + [("use", "use", "forget", "use")[i % 4] for i in range(6000)] + ["recent"], [[]] + [[i * 7919 % 1500] if i % 4 != 2 else [(i - 2) * 7919 % 1500] if i % 8 == 2 else [i * 31 % 1500] for i in range(6000)] + [[8]]))
fail[2]: Nothing used yet: recent is empty, and forget returns False.
fail[3]: Using the same item again doesn't add a second copy.
fail[4]: A forgotten item that's used again comes back, at the front.
fail[5]: Using 2 again moves it to the front, past 3.
fail[6]: 6,000 calls on 1,500 different items. Searching and shifting a Python list is O(n) a call; keep the nodes in a dictionary.
edges:
- nothing used :: "use" not in commands :: run(["RecentlyUsed", "recent"], [[], [1]])
- an item used twice :: len([a[0] for c, a in zip(commands, inputs) if c == "use"]) > len(set(a[0] for c, a in zip(commands, inputs) if c == "use")) :: run(["RecentlyUsed", "use", "use"], [[], [1], [1]])
- every item used once :: "use" in commands and len([a[0] for c, a in zip(commands, inputs) if c == "use"]) == len(set(a[0] for c, a in zip(commands, inputs) if c == "use")) :: run(["RecentlyUsed", "use", "use"], [[], [1], [2]])
edge_count: 2
complexity: time=O(1) | space=O(n)
complexity_note: Give the time of use; n is the number of items kept.
why_time: The dictionary finds the item's node in O(1), and moving it to the front is a few link changes.
why_space: One node and one dictionary entry per item.
hint: Write unlink(node), and push_front(node), which links node in between self.front and self.front.next.
hint: use: if x is in self.where, unlink its node; otherwise make a new node and store it in self.where. Then push_front(node).
hint: forget: return False if x isn't in self.where; otherwise unlink `self.where.pop(x)` and return True. recent: walk from self.front.next, stopping at self.back or after k items.
right: Moving a node to the front is an unlink and an insert after the front sentinel, both O(1), and the dictionary finds the node without a walk.
wrong: Keep the items between sentinels with a dictionary from item to node; use unlinks the item's node if there is one, or makes one, then links it in after the front sentinel; forget unlinks it and removes its key.

=== task: code medium
title: Swap Two Nodes
patterns: unlink + insert
prompt: The values of a doubly linked list are all different. Write `swap_nodes(head, a, b)` that swaps the nodes holding a and b by relinking them, without changing any values, and returns the head. a and b are both in the list, and a ≠ b.

The starter finds the two nodes, x first and y second in the list. If they're neighbours, the order before, x, y, after becomes before, y, x, after. Otherwise y takes x's place, between x's old neighbours, and x takes y's place. The helper `link(left, right)` sets `left.next = right` and `right.prev = left`, skipping whichever is None, so each connection is one line. If x was the head, y is the new head.

**Example 1:** `run([1, 2, 3, 4, 5], 2, 4)` returns `[1, 4, 3, 2, 5]`.

**Example 2:** `run([1, 2, 3, 4], 2, 3)` returns `[1, 3, 2, 4]`: the two nodes are neighbours.

**Constraints:** the list has 2 to 10⁴ nodes with different values, −10⁹ ≤ every value ≤ 10⁹, and a and b are in the list.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def link(left, right):
    if left is not None:
        left.next = right
    if right is not None:
        right.prev = left


def swap_nodes(head, a, b):
    found = []
    node = head
    while node is not None:
        if node.val == a or node.val == b:
            found.append(node)
        node = node.next
    x = found[0]
    y = found[1]
    # your code here
    return head


def run(values, a, b):
    return to_list(swap_nodes(from_list(values), a, b))
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def link(left, right):
    if left is not None:
        left.next = right
    if right is not None:
        right.prev = left


def swap_nodes(head, a, b):
    found = []
    node = head
    while node is not None:
        if node.val == a or node.val == b:
            found.append(node)
        node = node.next
    x = found[0]
    y = found[1]
    if x.next is y:
        before = x.prev
        after = y.next
        link(before, y)
        link(y, x)
        link(x, after)
    else:
        px = x.prev
        nx = x.next
        py = y.prev
        ny = y.next
        link(px, y)
        link(y, nx)
        link(py, x)
        link(x, ny)
    if head is x:
        return y
    return head


def run(values, a, b):
    return to_list(swap_nodes(from_list(values), a, b))
```
tests:
- run([1, 2, 3, 4, 5], 2, 4)
- run([1, 2, 3, 4], 2, 3)
- run([1, 2, 3], 3, 1)
- run([1, 2], 1, 2)
- run([5, 6, 7], 5, 6)
- (lambda t: [len(t), t[:3], t[-3:]])(run(list(range(10000)), 9999, 0))
fail[2]: Neighbours in the middle: three connections change.
fail[3]: b comes before a in the list, and the head and the tail swap.
fail[4]: Two nodes, which are neighbours, swap, so the head changes.
fail[5]: Neighbours at the front: the second node becomes the head.
fail[6]: 10,000 nodes, swapping the head and the tail.
edges:
- neighbours :: abs(values.index(a) - values.index(b)) == 1 :: run([1, 2], 1, 2)
- the head and another node :: abs(values.index(a) - values.index(b)) > 1 and min(values.index(a), values.index(b)) == 0 :: run([1, 2, 3], 1, 3)
- two nodes after the head :: abs(values.index(a) - values.index(b)) > 1 and min(values.index(a), values.index(b)) > 0 :: run([1, 2, 3, 4], 2, 4)
edge_count: 2
complexity: time=O(n) | space=O(1)
complexity_note: n is the number of nodes.
why_time: One walk to find the two nodes; the swap itself is O(1).
why_space: A few pointers; the nodes are relinked in place.
hint: Neighbours (`x.next is y`): before = x.prev and after = y.next; then link(before, y), link(y, x) and link(x, after).
hint: Otherwise save px, nx = x.prev, x.next and py, ny = y.prev, y.next first; then link(px, y), link(y, nx), link(py, x) and link(x, ny).
hint: Return y if head is x, and head otherwise.
right: Saving all four neighbours before changing anything means no link is read after it's been overwritten, and neighbours get their own three links because there x's next is y itself.
wrong: Find both nodes, save their neighbours, then link each node in where the other was, with a separate case for neighbours, and return the new head if the first node was the head.

=== task: code hard
title: Undo the Removals
patterns: map + unlink
prompt: Write a class `Links` for a doubly linked list built from values, whose nodes are numbered by their index in values:

- `Links(values)` builds the list.
- `remove(i)` takes node i out of the list. Node i is in the list.
- `undo()` puts back the node removed most recently, among those still out, and returns its value; it returns −1 if no node is out.
- `after(i)` returns the value of the node right after node i, or −1 if node i is the last node. Node i is in the list.
- `values()` returns the values in the list, in order.

Every method except values must be O(1). The starter keeps the nodes in a Python list by number, between two sentinels, and a stack, a Python list, of removed nodes. The trick for undo: when a node is removed, its own prev and next are left alone, so they still point at its old neighbours. Undos go in the reverse order of the removals, so by the time a node comes back, every node removed after it is back already, and its old neighbours are next to each other again: `node.prev.next = node` and `node.next.prev = node` put it back exactly where it was.

**Example:** `run(["Links", "remove", "remove", "values", "after", "undo", "values", "undo", "values"], [[[1, 2, 3, 4]], [1], [2], [], [0], [], [], [], []])` returns `[None, None, None, [1, 4], 4, 3, [1, 3, 4], 2, [1, 2, 3, 4]]`: after the 2 and the 3 are removed, the 4 comes right after the 1; the undos put back the 3, then the 2.

**Constraints:** there are 1 to 10⁴ values, 0 ≤ every value ≤ 10⁹, and at most 10⁴ calls.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Links:
    def __init__(self, values):
        self.front = DNode(None)
        self.back = DNode(None)
        self.nodes = []
        last = self.front
        for x in values:
            node = DNode(x, last)
            last.next = node
            self.nodes.append(node)
            last = node
        last.next = self.back
        self.back.prev = last
        self.removed = []

    def remove(self, i):
        pass

    def undo(self):
        return -1

    def after(self, i):
        return -1

    def values(self):
        return []


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Links":
            links = Links(args[0])
            results.append(None)
        elif command == "remove":
            results.append(links.remove(args[0]))
        elif command == "undo":
            results.append(links.undo())
        elif command == "after":
            results.append(links.after(args[0]))
        elif command == "values":
            results.append(links.values())
    return results
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class Links:
    def __init__(self, values):
        self.front = DNode(None)
        self.back = DNode(None)
        self.nodes = []
        last = self.front
        for x in values:
            node = DNode(x, last)
            last.next = node
            self.nodes.append(node)
            last = node
        last.next = self.back
        self.back.prev = last
        self.removed = []

    def remove(self, i):
        node = self.nodes[i]
        node.prev.next = node.next
        node.next.prev = node.prev
        self.removed.append(node)

    def undo(self):
        if len(self.removed) == 0:
            return -1
        node = self.removed.pop()
        node.prev.next = node
        node.next.prev = node
        return node.val

    def after(self, i):
        node = self.nodes[i].next
        if node is self.back:
            return -1
        return node.val

    def values(self):
        out = []
        node = self.front.next
        while node is not self.back:
            out.append(node.val)
            node = node.next
        return out


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Links":
            links = Links(args[0])
            results.append(None)
        elif command == "remove":
            results.append(links.remove(args[0]))
        elif command == "undo":
            results.append(links.undo())
        elif command == "after":
            results.append(links.after(args[0]))
        elif command == "values":
            results.append(links.values())
    return results
```
