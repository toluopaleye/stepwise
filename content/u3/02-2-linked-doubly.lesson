    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def merge_adjacent(head):
    node = head
    # your code here
    return head


def run(nums):
    return to_list(merge_adjacent(from_list(nums)))
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def merge_adjacent(head):
    node = head
    while node.next is not None:
        if node.val == node.next.val:
            right = node.next
            node.val += right.val
            node.next = right.next
            if right.next is not None:
                right.next.prev = node
            if node.prev is not None and node.prev.val == node.val:
                node = node.prev
        else:
            node = node.next
    return head


def run(nums):
    return to_list(merge_adjacent(from_list(nums)))
```
tests:
- run([3, 1, 1, 2])
- run([2, 2, 4])
- run([3, 7, 5])
- run([1])
- run([1, 1, 1])
- (lambda t: [len(t), t[:3], t[3998:]])(run(list(range(96000, 100000)) + [4, 2, 1, 1] * 1500))
fail[2]: The first two 2s merge into 4, which then equals the next node.
fail[3]: No two neighbours are equal, so nothing changes.
fail[4]: One node.
fail[5]: Three 1s: the leftmost pair merges into 2, and the last 1 stays.
fail[6]: 10,000 nodes: 4,000 rising values, then 6,000 whose merges keep stepping back. Starting again from the head after each merge is far too slow; step back with prev.
edges:
- one node :: len(nums) == 1 :: run([4])
- no equal neighbours :: len(nums) > 1 and all(nums[i] != nums[i + 1] for i in range(len(nums) - 1)) :: run([1, 2])
- equal neighbours :: any(nums[i] == nums[i + 1] for i in range(len(nums) - 1)) :: run([1, 1])
edge_count: 2
complexity: time=O(n) | space=O(1)
complexity_note: n is the number of nodes.
why_time: Every step forwards passes a node, and every step back follows a merge, which deletes a node; there are at most n of each.
why_space: The list changes in place; only a few pointers are kept.
hint: While node.next isn't None: if `node.val == node.next.val`, merge: right = node.next; `node.val += right.val`; `node.next = right.next`; if right.next isn't None, `right.next.prev = node`.
hint: After a merge, if node.prev isn't None and `node.prev.val == node.val`, step back with `node = node.prev`; otherwise stay on node.
hint: If the two values aren't equal, move on: `node = node.next`.
right: Nothing before the current node has equal neighbours, so after a merge the only new pairs are with the node before and the node after, and stepping back with prev checks the leftmost one first, in O(1).
wrong: Walk the list; when a node equals the next one, merge them into the first node, then step back one node if the node before is now equal, and otherwise check the same node again.

=== task: code medium
title: Infinite Tape
patterns: cursor + insert
prompt: A tape is a doubly linked list of cells, each holding a number, with a cursor on one cell. It starts as a single cell holding 0, under the cursor. Write `run_tape(program)` that runs a program, a string of commands, and returns the tape's leftmost cell:

- `L` moves the cursor one cell left, and `R` one cell right. The tape has no ends: when the cursor moves left from the leftmost cell, a new cell holding 0 is added there first, and the same on the right.
- `I` inserts a new cell holding 0 right after the cursor's cell, and the cursor moves onto it.
- `+` adds 1 to the cell under the cursor, and `-` takes 1 off.

Keep track of the leftmost cell as well as the cursor: a cell added at the left end becomes the new leftmost cell.

**Example 1:** `run("+R++L-")` returns `[0, 2]`: the first cell goes to 1, a new cell to its right goes to 2, then the first cell goes back to 0.

**Example 2:** `run("+++L+I-R")` returns `[1, -1, 3]`: the I puts a new cell between the new left cell and the first cell.

**Constraints:** the program has 0 to 2 × 10⁴ commands, each one of L, R, I, + and -.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
