        values.append(node.val)
        prev = node
        node = node.next
    return values


def delete_nodes(head, nodes):
    for node in nodes:
        # your code here
        pass
    return head


def run(values, indexes):
    head = from_list(values)
    nodes = []
    node = head
    while node is not None:
        nodes.append(node)
        node = node.next
    held = [nodes[i] for i in indexes]
    return to_list(delete_nodes(head, held))
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def delete_nodes(head, nodes):
    for node in nodes:
        if node.prev is None:
            head = node.next
        else:
            node.prev.next = node.next
        if node.next is not None:
            node.next.prev = node.prev
    return head


def run(values, indexes):
    head = from_list(values)
    nodes = []
    node = head
    while node is not None:
        nodes.append(node)
        node = node.next
    held = [nodes[i] for i in indexes]
    return to_list(delete_nodes(head, held))
```
tests:
- run([1, 2, 3, 4, 5], [1, 3])
- run([1, 2, 3], [0])
- run([1, 2, 3], [2])
- run([7], [0])
- run([1, 2, 3, 4], [1, 2, 0])
- (lambda t: [len(t), t[:4], t[-4:]])(run(list(range(10000)), [i * 2 for i in range(5000)]))
fail[2]: Deleting the head: the next node becomes the head, with prev None.
fail[3]: Deleting the tail: the node before it must end the list, with next None.
fail[4]: Deleting the only node leaves an empty list.
fail[5]: Neighbours 2 and 3 are deleted one after the other, then the head: each delete uses the links as they are after the deletes before it.
fail[6]: 10,000 nodes, of which 5,000 are deleted. Walking from the head to find the node before each one is far too slow; use prev.
edges:
- nothing to delete :: len(indexes) == 0 :: run([1, 2], [])
- the head is deleted :: 0 in indexes :: run([1, 2], [0])
- only nodes after the head :: len(indexes) > 0 and 0 not in indexes :: run([1, 2], [1])
edge_count: 2
complexity: time=O(k) | space=O(1)
complexity_options: O(k); O(n × k); O(k log n)
complexity_note: k is the number of nodes to delete; building the list in run isn't counted.
why_time: Each delete is a fixed number of link changes, with no walk.
why_space: Nothing new is kept: links change in place.
hint: If node.prev is None, the node is the head: `head = node.next`. Otherwise `node.prev.next = node.next`.
hint: If node.next isn't None: `node.next.prev = node.prev`.
hint: After the loop, return head.
right: Holding a node gives you both its neighbours through prev and next, so it comes out with two link changes, and a node deleted earlier has already linked its neighbours to each other.
wrong: For each node, link its two neighbours to each other, moving the head on when the node is the head, then return the head.

=== task: code easy
title: Move to Front
patterns: unlink + insert
prompt: Write `move_to_front(head, x)` that moves the first node holding x to the front of a doubly linked list and returns the head. If no node holds x, or the head already does, nothing changes. Move the node itself by changing links; don't change any values.

Find the node, take it out by linking its neighbours to each other (it isn't the head, so it has a node before it), then put it in front of the head.

**Example 1:** `run([1, 2, 3, 4], 3)` returns `[3, 1, 2, 4]`.

**Example 2:** `run([1, 2], 5)` returns `[1, 2]`: no node holds 5.

**Constraints:** the list has 0 to 10⁴ nodes, and −10⁹ ≤ every value and x ≤ 10⁹.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def move_to_front(head, x):
    node = head
    while node is not None and node.val != x:
        node = node.next
    # your code here
    return head


def run(values, x):
    return to_list(move_to_front(from_list(values), x))
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


def move_to_front(head, x):
    node = head
    while node is not None and node.val != x:
        node = node.next
    if node is None or node is head:
        return head
    node.prev.next = node.next
    if node.next is not None:
        node.next.prev = node.prev
    node.prev = None
    node.next = head
    head.prev = node
    return node


def run(values, x):
    return to_list(move_to_front(from_list(values), x))
```
tests:
- run([1, 2, 3, 4], 3)
- run([1, 2, 3], 1)
- run([1, 2, 3], 3)
- run([1, 2], 5)
- run([6, 5, 6, 5], 5)
- (lambda t: [len(t), t[:4], t[-3:]])(run(list(range(10000)), 9999))
fail[2]: The head already holds 1, so nothing changes.
fail[3]: Moving the tail: the node before it becomes the last node, with next None.
fail[4]: No node holds 5, so nothing changes.
fail[5]: Only the first 5 moves; the second one stays at the end.
fail[6]: 10,000 nodes, moving the tail to the front.
edges:
- x isn't there :: x not in values :: run([1, 2], 3)
- x is at the head :: len(values) > 0 and values[0] == x :: run([1, 2], 1)
- x is further on :: len(values) > 0 and values[0] != x and x in values :: run([1, 2], 2)
edge_count: 2
complexity: time=O(n) | space=O(1)
complexity_note: n is the number of nodes.
why_time: One walk to find x; the move itself is O(1).
why_space: Only a pointer; the node is relinked, not copied.
hint: The starter finds node. If node is None or node is head, return head.
hint: Take it out: `node.prev.next = node.next`, and if node.next isn't None, `node.next.prev = node.prev`.
hint: Put it in front: `node.prev = None`, `node.next = head`, `head.prev = node`, then return node.
right: Taking a node out and putting it back in front are each a few link changes, so the move costs nothing beyond the walk that finds the node.
wrong: Find the node; if it's there and isn't the head, link its neighbours to each other, then link it in front of the old head and return it as the new head.

=== task: code easy
title: Recent Log
patterns: sentinel
prompt: Write a class `RecentLog` that keeps the k most recent entries of a log:

- `RecentLog(k)` starts empty.
- `log(x)` adds the entry x. If there are then more than k entries, the oldest one is dropped.
- `latest(m)` returns the m newest entries, newest first, or all of them if there are fewer than m.
- `size()` returns how many entries are kept.

log and size must be O(1), and latest O(m). Keep the entries in a doubly linked list between two sentinels, oldest first: log inserts in front of the back sentinel and drops the node after the front sentinel, and latest walks backwards from the back sentinel along prev.

**Example:** `run(["RecentLog", "log", "log", "log", "latest", "log", "latest", "size"], [[2], [1], [2], [3], [5], [4], [1], []])` returns `[None, None, None, None, [3, 2], None, [4], 2]`: with k = 2, logging 3 drops the 1, and logging 4 drops the 2.

**Constraints:** 1 ≤ k ≤ 10⁴, at most 10⁴ calls, 0 ≤ m ≤ 10⁴, and −10⁹ ≤ x ≤ 10⁹.
starter:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class RecentLog:
    def __init__(self, k):
        self.k = k
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.count = 0

    def log(self, x):
        pass

    def latest(self, m):
        return []

    def size(self):
        return 0


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RecentLog":
            log = RecentLog(args[0])
            results.append(None)
        elif command == "log":
            results.append(log.log(args[0]))
        elif command == "latest":
            results.append(log.latest(args[0]))
        elif command == "size":
            results.append(log.size())
    return results
```
solution:
```python
class DNode:
    def __init__(self, val, prev=None, next=None):
        self.val = val
        self.prev = prev
        self.next = next


def from_list(values):
    head = None
    tail = None
    for x in values:
        node = DNode(x, tail)
        if tail is None:
            head = node
        else:
            tail.next = node
        tail = node
    return head


def to_list(head):
    values = []
    prev = None
    node = head
    while node is not None:
        if node.prev is not prev:
            return "prev link wrong at index " + str(len(values))
        values.append(node.val)
        prev = node
        node = node.next
    return values


class RecentLog:
    def __init__(self, k):
        self.k = k
        self.front = DNode(None)
        self.back = DNode(None)
        self.front.next = self.back
        self.back.prev = self.front
        self.count = 0

    def log(self, x):
        last = self.back.prev
        new = DNode(x, last, self.back)
        last.next = new
        self.back.prev = new
        self.count += 1
        if self.count > self.k:
            old = self.front.next
            self.front.next = old.next
            old.next.prev = self.front
            self.count -= 1

    def latest(self, m):
        out = []
        node = self.back.prev
        while node is not self.front and len(out) < m:
            out.append(node.val)
            node = node.prev
        return out

    def size(self):
        return self.count


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RecentLog":
            log = RecentLog(args[0])
            results.append(None)
        elif command == "log":
            results.append(log.log(args[0]))
        elif command == "latest":
            results.append(log.latest(args[0]))
        elif command == "size":
            results.append(log.size())
    return results
```
tests:
- run(["RecentLog", "log", "log", "log", "latest", "log", "latest", "size"], [[2], [1], [2], [3], [5], [4], [1], []])
- run(["RecentLog", "latest", "size"], [[3], [2], []])
- run(["RecentLog", "log", "log", "latest", "latest"], [[1], [8], [9], [1], [3]])
- run(["RecentLog", "log", "log", "log", "latest", "size"], [[5], [1], [1], [2], [0], []])
- run(["RecentLog", "log", "log", "log", "log", "latest"], [[3], [4], [5], [6], [7], [3]])
- (lambda r: [len(r), sum(len(x) for x in r if isinstance(x, list)), r[-1][:5]])(run(["RecentLog"] + ["log", "log", "latest"] * 2000, [[3000]] + [a for i in range(2000) for a in ([i], [i * 7], [i % 50 + 1])]))
fail[2]: A new log is empty: latest returns [] and size returns 0.
fail[3]: k = 1 keeps only the newest entry.
fail[4]: Equal entries are separate entries, and latest(0) returns an empty list.
fail[5]: Four entries with k = 3: the oldest is dropped, and latest(3) reads the other three newest first.
fail[6]: 6,000 calls with k = 3000. Dropping from the front of a Python list is O(k) each time; keep the entries in a linked list.
edges:
- nothing logged :: "log" not in commands :: run(["RecentLog", "size"], [[2], []])
- entries dropped :: commands.count("log") > inputs[0][0] :: run(["RecentLog", "log", "log", "size"], [[1], [5], [6], []])
- nothing dropped :: "log" in commands and commands.count("log") <= inputs[0][0] :: run(["RecentLog", "log", "size"], [[2], [5], []])
edge_count: 2
complexity: time=O(1) | space=O(k)
complexity_options: O(k); O(k²); O(m)
complexity_note: Give the time of log; k is the most entries kept.
why_time: log makes one node in front of the back sentinel and unlinks at most one node after the front sentinel.
why_space: At most k entries are kept, one node each, as well as the two sentinels.
hint: log: last = self.back.prev; `new = DNode(x, last, self.back)`; `last.next = new`; `self.back.prev = new`; add 1 to the count.
hint: Then, if the count is more than k: old = self.front.next; `self.front.next = old.next`; `old.next.prev = self.front`; take 1 off the count.
hint: latest: node = self.back.prev; while node is not self.front and fewer than m values are collected, append node.val and move to node.prev.
right: The sentinels mean every real node has neighbours on both sides, so adding at the back and dropping from the front are each a couple of link changes, and prev lets latest read the newest entries first.
wrong: Keep the entries between two sentinels, oldest first: log links a new node in before the back sentinel and unlinks the node after the front sentinel when there are too many; latest walks back from the back sentinel.

