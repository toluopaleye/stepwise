- max_score_sightseeing_pair([1, 2])
- max_score_sightseeing_pair([1, 1])
- max_score_sightseeing_pair([1000, 1, 1, 1000])
- max_score_sightseeing_pair([2, 2, 2, 2])
- max_score_sightseeing_pair([(i * 37) % 1000 + 1 for i in range(30000)])
