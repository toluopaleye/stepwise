```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


class MyLinkedList:
    def __init__(self):
        self.dummy = Node(0)
        self.size = 0

    def node_before(self, index):
        node = self.dummy
        for _ in range(index):
            node = node.next
        return node

    def get(self, index):
        if index < 0 or index >= self.size:
            return -1
        return self.node_before(index).next.val

    def add_at_head(self, val):
        self.add_at_index(0, val)

    def add_at_tail(self, val):
        self.add_at_index(self.size, val)

    def add_at_index(self, index, val):
        if index > self.size:
            return
        prev = self.node_before(index)
        prev.next = Node(val, prev.next)
        self.size += 1

    def delete_at_index(self, index):
        if index < 0 or index >= self.size:
            return
        prev = self.node_before(index)
        prev.next = prev.next.next
        self.size -= 1


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "MyLinkedList":
            lst = MyLinkedList()
            results.append(None)
        elif command == "get":
            results.append(lst.get(args[0]))
        elif command == "addAtHead":
            results.append(lst.add_at_head(args[0]))
        elif command == "addAtTail":
            results.append(lst.add_at_tail(args[0]))
        elif command == "addAtIndex":
            results.append(lst.add_at_index(args[0], args[1]))
        elif command == "deleteAtIndex":
            results.append(lst.delete_at_index(args[0]))
    return results
```
tests:
