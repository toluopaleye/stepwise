solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def delete_middle(head):
    if head.next is None:
        return None
    prev = None
    slow = head
    fast = head
    while fast is not None and fast.next is not None:
        prev = slow
        slow = slow.next
        fast = fast.next.next
    prev.next = slow.next
    return head


def run(values):
    return to_list(delete_middle(from_list(values)))
```
