- run(["MyLinkedList", "get", "addAtIndex", "get", "deleteAtIndex", "get"], [[], [0], [1, 5], [0], [0], [0]])
- run(["MyLinkedList", "addAtIndex", "addAtIndex", "addAtIndex", "get", "get", "get"], [[], [0, 10], [1, 30], [1, 20], [0], [1], [2]])
- run(["MyLinkedList", "addAtTail", "deleteAtIndex", "addAtHead", "addAtTail", "deleteAtIndex", "get", "get"], [[], [1], [0], [2], [3], [1], [0], [1]])
- run(["MyLinkedList", "addAtHead", "addAtHead", "deleteAtIndex", "deleteAtIndex", "get", "addAtTail", "get"], [[], [7], [8], [5], [0], [0], [9], [1]])
- sum(x for x in run(["MyLinkedList"] + [("addAtHead", "addAtTail", "addAtIndex", "get", "deleteAtIndex")[i % 5] for i in range(1500)], [[]] + [[i % 1001] if i % 5 < 2 else [i % 7, i % 1001] if i % 5 == 2 else [i % 13] for i in range(1500)]) if x is not None)
