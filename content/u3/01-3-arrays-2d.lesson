edges:
- no paints :: len(paints) == 0 :: paint_and_count(2, 2, [], [[0, 0, 1, 1]])
- one paint :: len(paints) == 1 :: paint_and_count(2, 2, [[0, 0, 0, 0, 3]], [[0, 0, 1, 1]])
