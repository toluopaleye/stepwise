    def __init__(self, memory_limit):
        self.limit = memory_limit
        self.packets = deque()
        self.stored = set()
        self.times = {}
        self.gone = {}

    def add_packet(self, source, destination, timestamp):
        return False

    def forward_packet(self):
        return []

    def get_count(self, destination, start_time, end_time):
        return 0


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Router":
            router = Router(args[0])
            results.append(None)
        elif command == "addPacket":
            results.append(router.add_packet(args[0], args[1], args[2]))
        elif command == "forwardPacket":
            results.append(router.forward_packet())
        elif command == "getCount":
            results.append(router.get_count(args[0], args[1], args[2]))
    return results
```
solution:
```python
from collections import deque
from bisect import bisect_left, bisect_right


class Router:
    def __init__(self, memory_limit):
        self.limit = memory_limit
        self.packets = deque()
        self.stored = set()
        self.times = {}
        self.gone = {}

    def add_packet(self, source, destination, timestamp):
        packet = (source, destination, timestamp)
        if packet in self.stored:
            return False
        if len(self.packets) == self.limit:
            self.forward_packet()
        self.packets.append(packet)
        self.stored.add(packet)
        if destination not in self.times:
            self.times[destination] = []
            self.gone[destination] = 0
        self.times[destination].append(timestamp)
        return True

    def forward_packet(self):
        if not self.packets:
            return []
        packet = self.packets.popleft()
        self.stored.discard(packet)
        self.gone[packet[1]] += 1
        return list(packet)

    def get_count(self, destination, start_time, end_time):
        if destination not in self.times:
            return 0
        times = self.times[destination]
        lo = self.gone[destination]
        return bisect_right(times, end_time, lo) - bisect_left(times, start_time, lo)


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Router":
            router = Router(args[0])
            results.append(None)
        elif command == "addPacket":
            results.append(router.add_packet(args[0], args[1], args[2]))
        elif command == "forwardPacket":
            results.append(router.forward_packet())
        elif command == "getCount":
            results.append(router.get_count(args[0], args[1], args[2]))
    return results
```
tests:
- run(["Router", "addPacket", "addPacket", "addPacket", "addPacket", "addPacket", "forwardPacket", "addPacket", "getCount"], [[3], [1, 4, 90], [2, 5, 90], [1, 4, 90], [3, 5, 95], [4, 5, 105], [], [5, 2, 110], [5, 100, 110]])
- run(["Router", "addPacket", "forwardPacket", "forwardPacket"], [[2], [7, 4, 90], [], []])
- run(["Router", "addPacket", "getCount"], [[2], [1, 2, 3], [9, 1, 10]])
- run(["Router", "addPacket", "addPacket", "addPacket", "getCount"], [[2], [1, 5, 10], [2, 5, 20], [3, 5, 30], [5, 1, 100]])
- run(["Router", "addPacket", "forwardPacket", "addPacket"], [[3], [1, 2, 5], [], [1, 2, 5]])
