solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def add_two_numbers(l1, l2):
    a = []
    while l1 is not None:
        a.append(l1.val)
        l1 = l1.next
    b = []
    while l2 is not None:
        b.append(l2.val)
        l2 = l2.next
    head = None
    carry = 0
    i = len(a) - 1
    j = len(b) - 1
    while i >= 0 or j >= 0 or carry > 0:
        total = carry
        if i >= 0:
            total += a[i]
            i -= 1
        if j >= 0:
            total += b[j]
            j -= 1
        head = Node(total % 10, head)
        carry = total // 10
    return head


def run(digits1, digits2):
    return to_list(add_two_numbers(from_list(digits1), from_list(digits2)))
```
tests:
- run([7, 2, 4, 3], [5, 6, 4])
- run([2, 4, 3], [5, 6, 4])
- run([0], [0])
- run([9, 9], [1])
- run([5], [5])
