        values.append(head.val)
        head = head.next
    return values


def insert_all(head, values):
    n = len(values)
    i = 0
    # your code here
    return head


def run(sorted_values, values):
    return to_list(insert_all(from_list(sorted_values), values))
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def insert_all(head, values):
    n = len(values)
    i = 0
    while i < n and (head is None or values[i] < head.val):
        i += 1
    for j in range(i - 1, -1, -1):
        head = Node(values[j], head)
    node = head
    while i < n:
        while node.next is not None and node.next.val <= values[i]:
            node = node.next
        node.next = Node(values[i], node.next)
        node = node.next
        i += 1
    return head


def run(sorted_values, values):
    return to_list(insert_all(from_list(sorted_values), values))
```
tests:
- run([1, 4, 9], [0, 5, 10])
- run([], [2, 3])
- run([2, 3], [])
- run([5, 5], [5, 5])
- run([10, 20], [1, 2, 3])
- (lambda t: [len(t), t[:6], t[-6:], sum(t)])(run(list(range(0, 12000, 2)), list(range(1, 12000, 2))))
fail[2]: The list is empty, so every value goes in front: the 3 first, then the 2 in front of it.
fail[3]: Nothing to insert.
fail[4]: Equal values all stay: four 5s.
fail[5]: All three values are smaller than the head, 10, and must end up in the order 1, 2, 3.
fail[6]: 6,000 sorted nodes and 6,000 values that go between them. Walking from the head for each value is far too slow.
edges:
- an empty list :: len(sorted_values) == 0 :: run([], [1])
- a value before the head :: len(sorted_values) > 0 and len(values) > 0 and values[0] < sorted_values[0] :: run([5], [1])
- no value before the head :: len(sorted_values) > 0 and (len(values) == 0 or values[0] >= sorted_values[0]) :: run([5], [6])
edge_count: 2
complexity: time=O(n + m) | space=O(m)
complexity_options: O(n + m); O(n × m); O(m log n); O(m)
complexity_note: n is the length of the list and m the number of values.
why_time: node only ever moves forward, at most n + m times in all, and each insert is O(1).
why_space: m new nodes.
hint: Move i past the values smaller than the head (all of them, if head is None), then insert `values[j]` at the front for j from i − 1 down to 0.
hint: Set `node = head`. For each remaining value, move node on while `node.next is not None and node.next.val <= value`.
hint: Then `node.next = Node(value, node.next)` and `node = node.next`.
right: The values are sorted, so the place for each one is never before the place of the one before it: one pointer moving forward finds every place in a single walk.
wrong: Put the values smaller than the head in front, last one first. Then walk the list once, moving forward to the right place for each value in turn and inserting it after the current node.

=== task: code hard
title: Pairs That Add Up
patterns: array
prompt: head is a linked list sorted from smallest to biggest, and its values can repeat. Write `count_pairs(head, target)` that returns how many pairs of nodes, one before the other, have values that add up to target.

Checking every pair is O(n²). On a sorted Python list, two indexes find the pairs in one pass: i from the start and j from the end. If the two values add up to less than target, i moves right; if more, j moves left. A singly linked list can't move j backwards, so copy the values into a Python list first.

When the sum is right, count every pair that the runs of equal values make. If the two values are the same, every pair from i to j works: with size = j − i + 1 nodes, that's `size * (size - 1) // 2` pairs, and you're done. Otherwise, count how many copies of the value at i sit next to each other (left), and how many of the value at j (right): that's left × right pairs, and both indexes skip past their runs.

**Example 1:** `run([1, 2, 3, 4, 5], 6)` returns 2: 1 + 5 and 2 + 4.

**Example 2:** `run([1, 1, 1], 2)` returns 3: every pair of the three 1s.

**Constraints:** the list has 0 to 2 × 10⁴ nodes, −10⁹ ≤ every value ≤ 10⁹, and −2 × 10⁹ ≤ target ≤ 2 × 10⁹.
starter:
```python
