    for command, args in zip(commands, inputs):
        if command == "Versions":
            versions = Versions()
            results.append(None)
        elif command == "push":
            results.append(versions.push(args[0], args[1]))
        elif command == "pop":
            results.append(versions.pop(args[0]))
        elif command == "top":
            results.append(versions.top(args[0]))
        elif command == "size":
            results.append(versions.size(args[0]))
    return results
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


class Versions:
    def __init__(self):
        self.heads = [None]
        self.sizes = [0]

    def push(self, v, x):
        self.heads.append(Node(x, self.heads[v]))
        self.sizes.append(self.sizes[v] + 1)
        return len(self.heads) - 1

    def pop(self, v):
        self.heads.append(self.heads[v].next)
        self.sizes.append(self.sizes[v] - 1)
        return len(self.heads) - 1

    def top(self, v):
        if self.heads[v] is None:
            return -1
        return self.heads[v].val

    def size(self, v):
        return self.sizes[v]


def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "Versions":
            versions = Versions()
            results.append(None)
        elif command == "push":
            results.append(versions.push(args[0], args[1]))
        elif command == "pop":
            results.append(versions.pop(args[0]))
        elif command == "top":
            results.append(versions.top(args[0]))
        elif command == "size":
            results.append(versions.size(args[0]))
    return results
```
