        values.append(head.val)
        head = head.next
    return values


def long_division(head, d):
    result = None
    tail = None
    remainder = 0
    # your code here
    return result, remainder


def run(digits, d):
    quotient, remainder = long_division(from_list(digits), d)
    return [to_list(quotient), remainder]
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def long_division(head, d):
    result = None
    tail = None
    remainder = 0
    node = head
    while node is not None:
        remainder = remainder * 10 + node.val
        digit = remainder // d
        remainder %= d
        if digit > 0 or result is not None:
            new = Node(digit)
            if tail is None:
                result = new
            else:
                tail.next = new
            tail = new
        node = node.next
    if result is None:
        result = Node(0)
    return result, remainder


def run(digits, d):
    quotient, remainder = long_division(from_list(digits), d)
    return [to_list(quotient), remainder]
```
tests:
- run([1, 2, 3, 4], 5)
- run([7], 9)
- run([0], 3)
- run([1, 0, 0], 4)
- run([9, 9, 9], 1)
- (lambda r: [len(r[0]), r[0][:6], r[0][-6:], r[1]])(run([9] + [i * 7 % 10 for i in range(9999)], 987654321))
fail[2]: 7 is less than 9, so the quotient is 0 and the remainder is 7. Every quotient digit was a 0, so make a single 0 node.
fail[3]: 0 divided by anything is 0, with remainder 0.
fail[4]: 100 = 4 × 25: the first quotient digit, 1 // 4, is a leading 0 and must be skipped.
fail[5]: Dividing by 1 gives the number back.
fail[6]: A 10,000-digit number divided by 987,654,321.
edges:
- d = 1 :: d == 1 :: run([4, 2], 1)
- a quotient of 0 :: d > 1 and int("".join(map(str, digits))) < d :: run([4], 9)
- a quotient above 0 :: d > 1 and int("".join(map(str, digits))) >= d :: run([4, 2], 9)
edge_count: 2
complexity: time=O(n) | space=O(n)
complexity_note: n is the number of digits; d has a fixed number of digits.
why_time: One walk, with one division per digit.
why_space: The quotient has up to n digits.
hint: For each node: `remainder = remainder * 10 + node.val`, `digit = remainder // d` and `remainder %= d`.
hint: Append the digit with a tail, unless it's 0 and nothing has been appended yet.
hint: After the walk, if result is still None, set it to `Node(0)`.
right: Long division needs the digits most significant first, which is the order a walk gives them, and each quotient digit is known as soon as its digit is read, so a tail builds the answer in the same walk.
wrong: Walk the digits with a running remainder: multiply it by 10 and add the digit, append remainder // d to the answer unless it's a leading 0, and keep remainder % d. Return the answer (or a single 0) and the remainder.
