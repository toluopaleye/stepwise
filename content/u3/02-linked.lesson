    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def count_pairs(head, target):
    values = []
    # your code here
    return 0


def run(values, target):
    return count_pairs(from_list(values), target)
```
solution:
```python
class Node:
    def __init__(self, val, next=None):
        self.val = val
        self.next = next


def from_list(values):
    head = None
    for x in reversed(values):
        head = Node(x, head)
    return head


def to_list(head):
    values = []
    while head is not None:
        values.append(head.val)
        head = head.next
    return values


def count_pairs(head, target):
    values = []
    node = head
    while node is not None:
        values.append(node.val)
        node = node.next
    i = 0
    j = len(values) - 1
    pairs = 0
    while i < j:
        total = values[i] + values[j]
        if total < target:
            i += 1
        elif total > target:
            j -= 1
        elif values[i] == values[j]:
            size = j - i + 1
            pairs += size * (size - 1) // 2
            break
        else:
            left = 1
            while values[i + left] == values[i]:
                left += 1
            right = 1
            while values[j - right] == values[j]:
                right += 1
            pairs += left * right
            i += left
            j -= right
    return pairs


def run(values, target):
    return count_pairs(from_list(values), target)
```
tests:
- run([1, 2, 3, 4, 5], 6)
- run([1, 1, 1], 2)
- run([4], 8)
- run([1, 1, 2, 3, 3, 3], 4)
- run([-3, 0, 3, 3], 0)
- run(sorted(i * 7919 % 1000 for i in range(12000)), 999)
fail[2]: All three 1s pair with each other: 3 pairs.
fail[3]: One node can't make a pair with itself.
fail[4]: Each of the two 1s pairs with each of the three 3s: 6 pairs. The single 2 would need another 2.
fail[5]: −3 pairs with both 3s: 2. The 0 would need another 0.
fail[6]: 12,000 sorted values from 0 to 999. Checking every pair is far too slow.
edges:
- fewer than two nodes :: len(values) < 2 :: run([4], 8)
- equal values that pair up :: len(values) >= 2 and any(values[i] == values[j] and 2 * values[i] == target for i in range(len(values)) for j in range(i + 1, len(values))) :: run([2, 2], 4)
- no equal values pair up :: len(values) >= 2 and not any(values[i] == values[j] and 2 * values[i] == target for i in range(len(values)) for j in range(i + 1, len(values))) :: run([1, 3], 4)
edge_count: 2
complexity: time=O(n) | space=O(n)
complexity_note: n is the number of nodes.
why_time: One walk to copy, then each step of the two indexes moves at least one of them inwards.
why_space: The copy holds n values.
hint: Copy the values, set `i = 0`, `j = len(values) - 1` and `pairs = 0`, and loop while i < j.
hint: If the sum is too small, add 1 to i; if it's too big, take 1 from j.
hint: If it's right and `values[i] == values[j]`, add `size * (size - 1) // 2` and stop. Otherwise count the run of `values[i]` from i and of `values[j]` back from j, add their product, and move i and j past the runs.
right: The copy lets the second index move backwards, and on a sorted list two indexes moving inwards meet every pair that could add up to target; runs of equal values are counted by multiplying, not one pair at a time.
wrong: Copy the values into a Python list and move two indexes inwards from both ends. When a pair adds up to target, add the product of the two runs of equal values, or, if both values are the same, the number of pairs between the two indexes.

=== task: code hard
