class Node:
    def __init__(self, val, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

def count(node):
    if node is None:
        return 0
    return 1 + count(node.left) + count(node.right)

def height(node):
    if node is None:
        return -1
    return 1 + max(height(node.left), height(node.right))

def is_perfect(node):
    return count(node) == 2 ** (height(node) + 1) - 1

a = Node(1, Node(2), Node(3))
b = Node(1, Node(2, Node(4)), Node(3))
print(is_perfect(a), is_perfect(b), is_perfect(Node(1)), count(b), height(b))
```
