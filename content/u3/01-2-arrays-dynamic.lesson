- run(["SummaryRanges", "add_num", "add_num", "get_intervals"], [[], [4], [4], []])
- run(["SummaryRanges", "add_num", "add_num", "get_intervals"], [[], [0], [1], []])
- run(["SummaryRanges", "add_num", "add_num", "add_num", "get_intervals"], [[], [10], [8], [9], []])
- run(["SummaryRanges", "add_num", "add_num", "add_num", "add_num", "get_intervals", "add_num", "get_intervals"], [[], [5], [1], [9], [3], [], [2], []])
- (lambda r: [len(r[3001]), r[-1]])(run(["SummaryRanges"] + ["add_num"] * 3000 + ["get_intervals"] + ["add_num"] * 300 + ["get_intervals"], [[]] + [[i + i // 10] for i in range(3000)] + [[]] + [[i * 11 + 10] for i in range(300)] + [[]]))
