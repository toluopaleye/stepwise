- a value added twice :: commands.count("add_num") > 1 and len(set(i[0] for c, i in zip(commands, inputs) if c == "add_num")) < commands.count("add_num") :: run(["SummaryRanges", "add_num", "add_num", "get_intervals"], [[], [5], [5], []])
- different values :: commands.count("add_num") > 1 and len(set(i[0] for c, i in zip(commands, inputs) if c == "add_num")) == commands.count("add_num") :: run(["SummaryRanges", "add_num", "add_num", "get_intervals"], [[], [5], [7], []])
