- run(["TextEditor", "delete_text", "cursor_left", "cursor_right"], [[], [3], [2], [2]])
- run(["TextEditor", "add_text", "cursor_left", "add_text", "cursor_right"], [[], ["ad"], [1], ["bc"], [5]])
- run(["TextEditor", "add_text", "cursor_left", "delete_text", "cursor_right"], [[], ["hello"], [2], [10], [1]])
- run(["TextEditor", "add_text", "cursor_left"], [[], ["abcdefghijkl"], [1]])
- run(["TextEditor"] + ["add_text"] * 2000 + ["cursor_left"] * 2000, [[]] + [["abcdefghij"]] * 2000 + [[10]] * 2000)[-2:]
