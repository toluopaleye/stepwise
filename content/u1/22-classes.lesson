    def __init__(self, balance):
        self.balance = balance

    def withdraw(self, amount):
        if amount > self.balance:
            return False
        self.balance -= amount
        return True

acc = Account(50)
r1 = acc.withdraw(20)
r2 = acc.withdraw(40)
r3 = acc.withdraw(30)
```
