hint: Words have at most 7 letters, so each has at most 7 prefixes and 7 suffixes: at most 49 pairs. That's few enough to store them all, once, in `__init__`.
hint: Make a dictionary from each `(prefix, suffix)` tuple to a position: for every word `w` at position `i`, every `w[:a]` with `a` from 1 to `len(w)`, and every `w[b:]` with `b` from 0 to `len(w) - 1`.
hint: Go through the words in order, so a later word overwrites an earlier one with the same pair, which keeps the largest position. `f` is then `self.best.get((pref, suff), -1)`.
right: Storing every prefix and suffix pair once turns each search into one look-up, and going through the words in order leaves the largest position for each pair.
wrong: In `__init__`, for each word and position, store `best[(w[:a], w[b:])] = i` for every prefix and suffix; `f` returns `best.get((pref, suff), -1)`.

=== task: code hard
title: Stream of Characters
leetcode: 1032 | Stream of Characters | stream-of-characters
patterns: nested + lookup + state
prompt: Letters arrive one at a time. Write a class `StreamChecker` that, after each letter, says whether the letters so far end with one of a list of words:
- `StreamChecker(words)` stores the words.
- `query(letter)` adds `letter` to the stream, and returns `True` if the stream now ends with some word of `words`, and `False` otherwise.

**Example 1:** `run(["StreamChecker", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query"], [[["cd", "f", "kl"]], ["a"], ["b"], ["c"], ["d"], ["e"], ["f"], ["g"], ["h"], ["i"], ["j"], ["k"], ["l"]])` returns `[None, False, False, False, True, False, True, False, False, False, False, False, True]`: the stream ends with "cd" after the "d", with "f" after the "f", and with "kl" after the "l".

**Constraints:** 1 ≤ `len(words)` ≤ 2000, each word has 1 to 200 small letters, each `letter` is a small letter, and there are at most 40,000 calls to `query`.
starter:
```python
class StreamChecker:
    def __init__(self, words):
        pass

    def query(self, letter):
        pass

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "StreamChecker":
            checker = StreamChecker(args[0])
            results.append(None)
        elif command == "query":
            results.append(checker.query(args[0]))
    return results
```
solution:
```python
class Node:
    def __init__(self):
        self.children = {}
        self.end = False

class StreamChecker:
    def __init__(self, words):
        self.root = Node()
        self.longest = 0
        for w in words:
            node = self.root
            for c in reversed(w):
                if c not in node.children:
                    node.children[c] = Node()
                node = node.children[c]
            node.end = True
            self.longest = max(self.longest, len(w))
        self.stream = []

    def query(self, letter):
        self.stream.append(letter)
        node = self.root
        stop = max(-1, len(self.stream) - 1 - self.longest)
        for i in range(len(self.stream) - 1, stop, -1):
            c = self.stream[i]
            if c not in node.children:
                return False
            node = node.children[c]
            if node.end:
                return True
        return False

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "StreamChecker":
            checker = StreamChecker(args[0])
            results.append(None)
        elif command == "query":
            results.append(checker.query(args[0]))
    return results
```
tests:
- run(["StreamChecker", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query", "query"], [[["cd", "f", "kl"]], ["a"], ["b"], ["c"], ["d"], ["e"], ["f"], ["g"], ["h"], ["i"], ["j"], ["k"], ["l"]])
- run(["StreamChecker", "query", "query"], [[["a"]], ["b"], ["a"]])
- run(["StreamChecker", "query", "query", "query"], [[["abc", "bc"]], ["a"], ["b"], ["c"]])
- run(["StreamChecker", "query", "query", "query"], [[["aa"]], ["a"], ["a"], ["a"]])
- run(["StreamChecker", "query", "query"], [[["xyz"]], ["y"], ["z"]])
- sum(run(["StreamChecker"] + ["query"] * 1800, [[[chr(97 + i % 26) + chr(97 + i // 26 % 26) + chr(97 + i // 676) + "xyz" for i in range(1000)]]] + [[c] for c in "".join([chr(97 + i % 26) + chr(97 + i // 26 % 26) + chr(97 + i // 676) + "xyz" for i in range(300)])])[1:])
fail[2]: The stream "b" doesn't end with "a", but "ba" does.
fail[3]: After "c", the stream "abc" ends with both words.
fail[4]: "aa" fits the last two letters after the second "a", and again after the third.
fail[5]: The stream "yz" is too short to end with "xyz".
fail[6]: The stream is 300 of the words one after another, so it ends with a word exactly 300 times. Checking every word after every letter takes too long here.
error[TimeoutError]: Checking every word after each letter takes too long. Store the words backwards in a tree of letter nodes, and after each letter walk back through the stream, following one child per letter.
edges:
- one word ending another :: any(v != w and v.endswith(w) for v in inputs[0][0] for w in inputs[0][0]) :: run(["StreamChecker", "query", "query"], [[["ab", "b"]], ["a"], ["b"]])
- a word longer than the stream :: any(len(w) > commands.count("query") for w in inputs[0][0]) :: run(["StreamChecker", "query"], [[["xyz"]], ["z"]])
- the same letter over and over :: len(commands) > 2 and len(set([a[0] for c, a in zip(commands, inputs) if c == "query"])) == 1 :: run(["StreamChecker", "query", "query"], [[["aa"]], ["a"], ["a"]])
edge_count: 2
hint: The stream has to **end** with a word, so compare from the newest letter backwards. Store each word backwards: "cd" as "d", then "c".
hint: Build a tree of letter nodes in `__init__`: each `Node` has a dictionary `children` from letter to node, and a flag `end` that marks where a whole word finishes. For each word, walk `reversed(w)` from the root, making any missing nodes, and set `end = True` on the last one.
hint: Keep the stream in a list. In `query`, append the letter, then walk the tree from the root using the stream's letters from the newest back: stop with `False` when a letter has no child, and return `True` as soon as you reach a node with `end`. You never need more letters than the longest word.
right: Storing the words backwards in a tree lets each query follow the newest letters back, one child per letter, and stop as soon as no word can fit.
wrong: Build a tree of `Node`s from the reversed words, marking word ends. Keep the stream; after each letter, walk the tree from the root with the stream's letters from newest to oldest, returning `True` at a word end and `False` when a letter has no child.

=== task: code hard
title: Range Module
leetcode: 715 | Range Module | range-module
patterns: state
prompt: A range module tracks which numbers on the number line are covered. A range `[left, right)` covers every number from `left` up to, but not including, `right`, fractions included. Write a class `RangeModule`:
- `RangeModule()` starts with nothing tracked.
- `add_range(left, right)` starts tracking every number in `[left, right)`. Parts already tracked stay tracked.
- `query_range(left, right)` returns `True` if every number in `[left, right)` is tracked.
- `remove_range(left, right)` stops tracking every number in `[left, right)`.

`add_range` and `remove_range` return nothing.

**Example 1:** `run(["RangeModule", "add_range", "remove_range", "query_range", "query_range", "query_range"], [[], [10, 20], [14, 16], [10, 14], [13, 15], [16, 17]])` returns `[None, None, None, True, False, True]`: after removing `[14, 16)`, `[10, 14)` and `[16, 20)` are tracked, so `[13, 15)` has a gap.

**Constraints:** 1 ≤ `left` < `right` ≤ 1,000,000,000, and there are at most 10,000 calls.
starter:
```python
class RangeModule:
    def __init__(self):
        pass

    def add_range(self, left, right):
        pass

    def query_range(self, left, right):
        pass

    def remove_range(self, left, right):
        pass

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RangeModule":
            module = RangeModule()
            results.append(None)
        elif command == "add_range":
            results.append(module.add_range(args[0], args[1]))
        elif command == "query_range":
            results.append(module.query_range(args[0], args[1]))
        elif command == "remove_range":
            results.append(module.remove_range(args[0], args[1]))
    return results
```
solution:
```python
class RangeModule:
    def __init__(self):
        self.ranges = []

    def add_range(self, left, right):
        kept = []
        for l, r in self.ranges:
            if r < left or l > right:
                kept.append([l, r])
            else:
                left = min(left, l)
                right = max(right, r)
        kept.append([left, right])
        self.ranges = sorted(kept)

    def query_range(self, left, right):
        return any(l <= left and right <= r for l, r in self.ranges)

    def remove_range(self, left, right):
        kept = []
        for l, r in self.ranges:
            if r <= left or l >= right:
                kept.append([l, r])
            else:
                if l < left:
                    kept.append([l, left])
                if r > right:
                    kept.append([right, r])
        self.ranges = kept

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RangeModule":
            module = RangeModule()
            results.append(None)
        elif command == "add_range":
            results.append(module.add_range(args[0], args[1]))
        elif command == "query_range":
            results.append(module.query_range(args[0], args[1]))
        elif command == "remove_range":
            results.append(module.remove_range(args[0], args[1]))
    return results
```
tests:
- run(["RangeModule", "add_range", "remove_range", "query_range", "query_range", "query_range"], [[], [10, 20], [14, 16], [10, 14], [13, 15], [16, 17]])
- run(["RangeModule", "query_range"], [[], [1, 2]])
- run(["RangeModule", "add_range", "add_range", "query_range"], [[], [1, 5], [5, 9], [2, 8]])
- run(["RangeModule", "add_range", "add_range", "query_range", "remove_range", "query_range", "query_range"], [[], [1, 3], [6, 9], [2, 7], [7, 8], [6, 7], [8, 9]])
- run(["RangeModule", "add_range", "remove_range", "query_range", "add_range", "query_range"], [[], [5, 10], [1, 20], [5, 6], [8, 12], [9, 12]])
- run(["RangeModule", "add_range", "remove_range", "query_range", "query_range"], [[], [1, 1000000000], [500, 600], [1, 500], [1, 501]])
fail[2]: Nothing is tracked yet.
fail[3]: `[1, 5)` and `[5, 9)` touch at 5, so together they cover `[1, 9)` with no gap.
fail[4]: `[3, 6)` was never tracked. After removing `[7, 8)`, both `[6, 7)` and `[8, 9)` are still tracked.
fail[5]: Removing `[1, 20)` clears everything, and then only `[8, 12)` is tracked.
fail[6]: The range covers almost a billion numbers, far too many to store one by one. After the removal, `[1, 500)` is still tracked, but 500 isn't.
error[TimeoutError]: Storing every number one by one takes too long: a range can cover a billion numbers. Keep a sorted list of the tracked ranges themselves, as `[left, right]` pairs that don't overlap.
error[MemoryError]: Storing every number takes too much memory: a range can cover a billion numbers. Keep the tracked ranges themselves as pairs instead.
edges:
- removing the middle of a range :: any(c == "remove_range" and any(d == "add_range" and b[0] < a[0] and a[1] < b[1] for d, b in zip(commands, inputs)) for c, a in zip(commands, inputs)) :: run(["RangeModule", "add_range", "remove_range", "query_range"], [[], [1, 10], [4, 6], [1, 4]])
- ranges that only touch :: any(a[1] == b[0] for c, a in zip(commands, inputs) for d, b in zip(commands, inputs) if c == "add_range" and d == "add_range") :: run(["RangeModule", "add_range", "add_range", "query_range"], [[], [1, 3], [3, 5], [2, 4]])
- a query before anything is added :: len(commands) > 1 and commands[1] == "query_range" :: run(["RangeModule", "query_range"], [[], [1, 2]])
edge_count: 2
hint: Keep the tracked numbers as a list of ranges `[l, r]` that don't overlap or touch, in order. A billion numbers then take one pair.
hint: `add_range` merges: every stored range that overlaps or touches `[left, right]` (when `not (r < left or l > right)`) is swallowed, by stretching `left` and `right` to cover it. Keep the others, add the merged range, and sort.
hint: `remove_range` keeps each stored range that's clear of `[left, right)`. A range that overlaps it is cut: the piece before, `[l, left]`, is kept if `l < left`, and the piece after, `[right, r]`, if `r > right`.
hint: Because touching ranges are always merged, `query_range` is `True` exactly when one stored range holds all of `[left, right)`: `l <= left and right <= r`.
right: Storing whole ranges instead of numbers keeps the list short, merging touching ranges means one range can answer a query, and cutting the overlapping ranges handles removals.
wrong: Keep a sorted list of separate ranges. `add_range` merges every range that overlaps or touches the new one; `remove_range` keeps the parts of each range outside `[left, right)`; `query_range` checks whether one range holds `[left, right)`.

=== task: code hard
title: All O`one Data Structure
leetcode: 432 | All O`one Data Structure | all-oone-data-structure
patterns: chain + lookup + nested
prompt: Write a class `AllOne` that counts strings, where every call takes the same small number of steps, however many strings there are:
- `AllOne()` starts with no strings.
- `inc(key)` adds 1 to the count of `key`. A new key starts with a count of 1.
- `dec(key)` takes 1 off the count of `key`, and removes the key when its count reaches 0. The key is always there.
- `get_max_key()` returns a key with the highest count, and `get_min_key()` a key with the lowest count. If several keys are tied, return the one that comes first alphabetically. If there are no keys, return `""`.

`inc` and `dec` return nothing.

**Example 1:** `run(["AllOne", "inc", "inc", "get_max_key", "get_min_key", "inc", "get_max_key", "get_min_key"], [[], ["hello"], ["hello"], [], [], ["leet"], [], []])` returns `[None, None, None, "hello", "hello", None, "hello", "leet"]`: "hello" has a count of 2, and "leet" arrives with 1.

**Constraints:** each key has 1 to 10 small letters, every `dec` is for a key that's there, and there are at most 50,000 calls.
starter:
```python
class AllOne:
    def __init__(self):
        pass

    def inc(self, key):
        pass

    def dec(self, key):
        pass

    def get_max_key(self):
        pass

    def get_min_key(self):
        pass

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "AllOne":
            counter = AllOne()
            results.append(None)
        elif command == "inc":
            results.append(counter.inc(args[0]))
        elif command == "dec":
            results.append(counter.dec(args[0]))
        elif command == "get_max_key":
            results.append(counter.get_max_key())
        elif command == "get_min_key":
            results.append(counter.get_min_key())
    return results
```
solution:
```python
class Bucket:
    def __init__(self, count):
        self.count = count
        self.keys = set()
        self.prev = None
        self.next = None

class AllOne:
    def __init__(self):
        self.head = Bucket(0)
        self.tail = Bucket(0)
        self.head.next = self.tail
        self.tail.prev = self.head
        self.where = {}

    def insert_after(self, bucket, count):
        new = Bucket(count)
        new.prev = bucket
        new.next = bucket.next
        bucket.next.prev = new
        bucket.next = new
        return new

    def unlink(self, bucket):
        bucket.prev.next = bucket.next
        bucket.next.prev = bucket.prev

    def inc(self, key):
        old = self.where.get(key, self.head)
        target = old.next
        if target is self.tail or target.count != old.count + 1:
            target = self.insert_after(old, old.count + 1)
        target.keys.add(key)
        self.where[key] = target
        if old is not self.head:
            old.keys.remove(key)
            if len(old.keys) == 0:
                self.unlink(old)

    def dec(self, key):
        old = self.where[key]
        if old.count == 1:
            del self.where[key]
        else:
            target = old.prev
            if target is self.head or target.count != old.count - 1:
                target = self.insert_after(old.prev, old.count - 1)
            target.keys.add(key)
            self.where[key] = target
        old.keys.remove(key)
        if len(old.keys) == 0:
            self.unlink(old)

    def get_max_key(self):
        if self.tail.prev is self.head:
            return ""
        return min(self.tail.prev.keys)

    def get_min_key(self):
        if self.head.next is self.tail:
            return ""
        return min(self.head.next.keys)

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "AllOne":
            counter = AllOne()
            results.append(None)
        elif command == "inc":
            results.append(counter.inc(args[0]))
        elif command == "dec":
            results.append(counter.dec(args[0]))
        elif command == "get_max_key":
            results.append(counter.get_max_key())
        elif command == "get_min_key":
            results.append(counter.get_min_key())
    return results
```
tests:
- run(["AllOne", "inc", "inc", "get_max_key", "get_min_key", "inc", "get_max_key", "get_min_key"], [[], ["hello"], ["hello"], [], [], ["leet"], [], []])
- run(["AllOne", "get_max_key", "get_min_key"], [[], [], []])
- run(["AllOne", "inc", "dec", "get_max_key"], [[], ["a"], ["a"], []])
- run(["AllOne", "inc", "inc", "inc", "dec", "get_max_key", "get_min_key"], [[], ["b"], ["a"], ["b"], ["b"], [], []])
- run(["AllOne", "inc", "inc", "inc", "inc", "dec", "get_max_key", "get_min_key"], [[], ["x"], ["y"], ["y"], ["z"], ["x"], [], []])
