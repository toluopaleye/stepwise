- run(["WordFilter", "f", "f"], [[["apple", "ample", "apply"]], ["a", "e"], ["ap", "y"]])
- run(["WordFilter", "f"], [[["cat"]], ["cat", "cat"]])
- run(["WordFilter", "f", "f"], [[["abc", "xyz"]], ["ab", "z"], ["x", "z"]])
- run(["WordFilter", "f", "f"], [[["ab", "ba", "ab"]], ["a", "b"], ["b", "b"]])
- sum(run(["WordFilter"] + ["f"] * 1500, [[[chr(97 + i % 26) + chr(97 + i // 26 % 26) + chr(97 + i // 676) + "q" for i in range(1500)]]] + [[chr(97 + i % 26), "q"] for i in range(1500)])[1:])
