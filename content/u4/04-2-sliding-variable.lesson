```python
def count_under(nums, limit):
    left = 0
    total = 0
    count = 0
    for right in range(len(nums)):
        total += nums[right]
        while total > limit:
            total -= nums[left]
            left += 1
        count += right - left + 1
    return count

print(count_under([2, 2, 2], 4), count_under([5], 3))
```
