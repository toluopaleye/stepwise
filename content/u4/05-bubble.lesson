people = [("Ana", 30), ("Ben", 25), ("Cy", 30)]

def by_age(records, ties_swap):
    n = len(records)
    for end in range(n - 1, 0, -1):
        for i in range(end):
            a = records[i][1]
            b = records[i + 1][1]
            if a > b or (ties_swap and a == b):
                records[i], records[i + 1] = records[i + 1], records[i]
    return [r[0] for r in records]

print(by_age(list(people), False), by_age(list(people), True))
