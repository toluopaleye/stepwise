- rebuild_order({"buy": [], "chop": ["buy"], "boil": [], "cook": ["chop", "boil"], "table": [], "serve": ["cook", "table"]}, "buy")
- rebuild_order({"buy": [], "chop": ["buy"], "boil": [], "cook": ["chop", "boil"], "table": [], "serve": ["cook", "table"]}, "serve")
- rebuild_order({"app": ["api", "cli"], "api": ["util"], "cli": ["util"], "util": [], "docs": []}, "util")
- rebuild_order({"app": ["api", "cli"], "api": ["util"], "cli": ["util"], "util": [], "docs": []}, "cli")
