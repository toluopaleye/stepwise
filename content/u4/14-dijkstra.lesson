{'P': 0, 'Q': 2, 'R': 1, 'S': 3}
```

Not every line is needed.
lines:
```python
def dijkstra_scan(graph, start):
    dist = {v: float("inf") for v in graph}
    dist[start] = 0
    done = set()
    while len(done) < len(graph):
        u = None
        for v in graph:
            if v not in done and (u is None or dist[v] < dist[u]):
                u = v
        if dist[u] == float("inf"):
            break
        done.add(u)
        for v, w in graph[u]:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
    return dist
