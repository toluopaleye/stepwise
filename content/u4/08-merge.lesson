    items = items[:]
    width = 1
    # your code here
    return items
```
solution:
```python
def merge(left, right):
    merged = []
    i = 0
    j = 0
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            merged.append(left[i])
            i += 1
        else:
            merged.append(right[j])
            j += 1
    return merged + left[i:] + right[j:]

def merge_sort_bottom_up(items):
    items = items[:]
    width = 1
    while width < len(items):
        out = []
        for lo in range(0, len(items), 2 * width):
            left = items[lo:lo + width]
            right = items[lo + width:lo + 2 * width]
            out.extend(merge(left, right))
        items = out
        width *= 2
    return items
```
tests:
- merge_sort_bottom_up([5, 1, 4, 2, 8, 3, 7, 6])
- merge_sort_bottom_up([3, 1, 2])
- merge_sort_bottom_up([])
- merge_sort_bottom_up([1])
- merge_sort_bottom_up([2, 2, 1, 1, 3])
speed: setup=items = list(range(n, 0, -1)) | call=merge_sort_bottom_up(items) | target=O(n log n)
slow:
```python
def merge_sort_bottom_up(items):
    items = items[:]
    for i in range(1, len(items)):
        key = items[i]
        j = i - 1
        while j >= 0 and items[j] > key:
            items[j + 1] = items[j]
            j -= 1
        items[j + 1] = key
    return items
```
