def is_palindrome_text(s):
    left = 0
    right = len(s) - 1
    while left < right:
        if not s[left].isalpha():
            left += 1
        elif not s[right].isalpha():
            right -= 1
        elif s[left].lower() != s[right].lower():
            return False
        else:
            left += 1
            right -= 1
    return True

print(is_palindrome_text("A man, a plan, a canal: Panama"), is_palindrome_text("Race a car"), is_palindrome_text("!!"))
```
