        r = random.randint(lo, ??)
        items[r], items[??] = items[hi], items[r]
        p = partition(items, lo, hi)
        quicksort(items, lo, p - 1)
        quicksort(items, p + 1, hi)

random.seed(1)
nums = [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]
quicksort(nums, 0, len(nums) - 1)
print(nums)
```
