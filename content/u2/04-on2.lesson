        return (p[0] - q[0]) ** 2 + (p[1] - q[1]) ** 2
    total = 0
    for i in range(len(points)):
        for j in range(len(points)):
            for k in range(len(points)):
                if i != j and i != k and j != k:
                    if dist(points[i], points[j]) == dist(points[i], points[k]):
                        total += 1
    return total
```
