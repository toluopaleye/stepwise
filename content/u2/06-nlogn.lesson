- k too big for any pair :: len(set(nums)) == len(nums) and count_excellent_pairs(nums, k) == 0 :: count_excellent_pairs([1, 2], 5)
- every pair is excellent :: len(set(nums)) == len(nums) and count_excellent_pairs(nums, k) == len(nums) ** 2 :: count_excellent_pairs([7, 3], 4)
edge_count: 2
