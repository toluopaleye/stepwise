- unequal_triplets([1, 1, 1, 1, 1])
- unequal_triplets([1, 2, 3])
- unequal_triplets([5, 5, 6])
- unequal_triplets([1, 2, 3, 4])
- unequal_triplets([i % 10 + 1 for i in range(100)])
