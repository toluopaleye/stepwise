- four_sum([2, 2, 2, 2, 2], 8)
- four_sum([1, 2, 3], 6)
- four_sum([0, 0, 0, 0], 1)
- four_sum([-3, -1, 0, 2, 4, 5], 0)
- len(four_sum([i % 20 - 10 for i in range(40)], 0))
