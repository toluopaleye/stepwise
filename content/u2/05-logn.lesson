- a, b and c all equal :: a == b == c :: nth_ugly_number(4, 5, 5, 5)
- one of them divides another :: len({a, b, c}) == 3 and (b % a == 0 or c % a == 0 or c % b == 0 or a % b == 0 or a % c == 0 or b % c == 0) :: nth_ugly_number(5, 2, 4, 7)
