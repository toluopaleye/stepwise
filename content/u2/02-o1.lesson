fail[3]: The stack holds only 1 number, so pushing 6 does nothing, and `pop` returns 5.
fail[4]: Only the bottom number gets the 10. The top pops as 2, and the 1 below it pops as 11.
fail[5]: An increment on an empty stack changes nothing, not even the numbers pushed later.
fail[6]: All 500 numbers get 1 added 500 times, so each one pops as 500.
speed: setup=st = CustomStack(n); [st.push(i) for i in range(n)] | call=st.increment(n, 1) | target=O(1)
slow:
```python
class CustomStack:
    def __init__(self, max_size):
        self.max_size = max_size
        self.items = []

    def push(self, x):
        if len(self.items) < self.max_size:
            self.items.append(x)

    def pop(self):
        if len(self.items) == 0:
            return -1
        return self.items.pop()

    def increment(self, k, val):
        for i in range(min(k, len(self.items))):
            self.items[i] += val

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "CustomStack":
            stack = CustomStack(args[0])
            results.append(None)
        elif command == "push":
            results.append(stack.push(args[0]))
        elif command == "pop":
            results.append(stack.pop())
        elif command == "increment":
            results.append(stack.increment(args[0], args[1]))
    return results
```
