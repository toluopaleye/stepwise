```python
import random

class RandomizedSet:
    def __init__(self):
        self.items = []

    def insert(self, val):
        if val in self.items:
            return False
        self.items.append(val)
        return True

    def remove(self, val):
        if val not in self.items:
            return False
        self.items.remove(val)
        return True

    def get_random(self):
        return random.choice(self.items)

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "RandomizedSet":
            s = RandomizedSet()
            results.append(None)
        elif command == "insert":
            results.append(s.insert(args[0]))
        elif command == "remove":
            results.append(s.remove(args[0]))
        elif command == "get_random":
            results.append(s.get_random())
    return results
```
fail[speed]: `in` and `remove` on a list walk through the items: O(n) per call. Keep a dictionary from each number to its position in the list, and fill the gap of a removed number with the last one.
edges:
- the same number inserted twice :: len([a[0] for c, a in zip(commands, inputs) if c == "insert"]) > len(set([a[0] for c, a in zip(commands, inputs) if c == "insert"])) :: run(["RandomizedSet", "insert", "insert"], [[], [5], [5]])
- removing a number that was never inserted :: any(c == "remove" and a[0] not in [b[0] for d, b in zip(commands, inputs) if d == "insert"] for c, a in zip(commands, inputs)) :: run(["RandomizedSet", "remove"], [[], [5]])
- removing the number at the end of the list :: any(commands[i] == "remove" and commands[i - 1] == "insert" and inputs[i][0] == inputs[i - 1][0] for i in range(2, len(commands))) :: run(["RandomizedSet", "insert", "insert", "remove"], [[], [1], [2], [2]])
