class FindSumPairs:
    def __init__(self, nums1, nums2):
        self.nums1 = nums1
        self.nums2 = nums2

    def add(self, index, val):
        self.nums2[index] += val

    def count(self, tot):
        total = 0
        for x in self.nums1:
            for y in self.nums2:
                if x + y == tot:
                    total += 1
        return total

def run(commands, inputs):
    results = []
    for command, args in zip(commands, inputs):
        if command == "FindSumPairs":
            pairs = FindSumPairs(args[0], args[1])
            results.append(None)
        elif command == "add":
            results.append(pairs.add(args[0], args[1]))
        elif command == "count":
            results.append(pairs.count(args[0]))
    return results
```
